# 서명에 쓰는 값의 "이름". 값 자체는 여기 없습니다 (ADR-0043).
#
# 인증서와 공증 자격증명은 러너가 도는 맥의 키체인에 있습니다. 그 맥을 떠나지
# 않게 하려고 self-hosted 러너를 씁니다.

# `security find-identity -v -p codesigning` 으로 확인한 정확한 이름.
ALLEY_SIGNING_IDENTITY="Developer ID Application: Example Inc. (ABCDE12345)"

# `xcrun notarytool store-credentials` 로 저장한 프로필 이름.
ALLEY_NOTARY_PROFILE="alley"
