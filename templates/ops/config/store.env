# 이 스토어가 어떤 값으로 도는가.
#
# 서버에 주는 환경변수는 여기가 아니라 배포 플랫폼의 시크릿에 있습니다. 여기 적는
# 것은 **빌드할 때 번들에 박히는 값** 입니다.

# 워커 번들 ID. 조직 접두어를 씁니다.
ALLEY_WORKER_BUNDLE_ID="com.example.alley.worker"

# 스토어 앱 번들 ID, 이름, 커스텀 URL 스킴.
#
# 번들 ID 는 "이 앱이 깔려 있나" 의 기준입니다. 틀리면 설치 여부 판단이 어긋나는데
# 빌드는 그냥 성공합니다.
#
# 스킴은 이미 깔린 앱의 로그인이 깨지므로 나중에 바꾸지 마세요. 서버의
# `STORE_APP_URL_SCHEME` 과 같아야 합니다.
#
# 이름은 `.app` 번들 이름이 됩니다. 웹 콘솔에 보이는 스토어 이름(`STORE_NAME`)과는
# 다른 값입니다.
ALLEY_STORE_APP_BUNDLE_ID="com.example.alley.store"
ALLEY_STORE_APP_NAME="Alley Store"
ALLEY_STORE_APP_URL_SCHEME="alleystore"

# 이 앱이 붙을 스토어 주소. 받은 사람은 주소를 입력하지 않습니다 (제품 ADR-0044).
#
# **주소를 옮기면 앱을 다시 빌드해 올려야 합니다.** 깔려 있는 앱들은 스스로
# 업데이트하며 따라오지만, 옛 주소가 먼저 죽으면 그 업데이트도 받지 못합니다.
# 두 주소를 한동안 함께 살려두세요.
#
# 비워두면 앱이 첫 화면에서 주소를 묻습니다. 아무 서버에나 붙는 빌드가 필요할
# 때만 그렇게 하세요.
ALLEY_STORE_APP_SERVER_URL="https://store.example.com"
