# 이 스토어가 어떤 값으로 도는가.
#
# 서버에 주는 환경변수는 여기가 아니라 배포 플랫폼의 시크릿에 있습니다. 여기 적는
# 것은 **빌드할 때 번들에 박히는 값** 입니다.

# 워커 번들 ID. 조직 접두어를 씁니다.
ALLEY_WORKER_BUNDLE_ID="com.example.alley.worker"

# 스토어 앱 번들 ID 와 커스텀 URL 스킴.
# 스킴은 이미 깔린 앱의 로그인이 깨지므로 나중에 바꾸지 마세요.
ALLEY_STORE_APP_BUNDLE_ID="com.example.alley.store"
ALLEY_STORE_APP_URL_SCHEME="alleystore"
