# Alley 서버 설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#
# 이 서버는 어떤 조직에도 묶여 있지 않습니다.
# 조직 고유값은 전부 아래 환경변수로만 들어옵니다.

# --- 스토어 브랜딩 ---
# 아래 다섯 항목(STORE_NAME ~ ENFORCE_BUNDLE_ID_PREFIX)은 데이터베이스에 설정 행이
# 아직 없을 때 한 번만 쓰이는 초기값입니다. 행이 생긴 뒤로는 관리자 화면에서 바꾸고
# 이 파일을 고쳐도 아무 일도 일어나지 않습니다. 자세한 경계는 ADR-0011 을 보세요.
STORE_NAME=Alley
# STORE_LOGO_URL=https://example.com/logo.png
# STORE_ACCENT_COLOR=#3478F6

# 로그인을 허용할 이메일 도메인. 쉼표로 구분합니다.
# 비워두면 도메인 제한 없이 누구나 로그인할 수 있으니 운영 환경에서는 반드시 설정하세요.
ALLOWED_EMAIL_DOMAINS=example.com

# 최초 기동 시 admin 으로 승격할 계정.
# 관리자가 0명일 때 첫 관리자를 만드는 값이라 관리자 화면에 둘 수 없습니다.
INITIAL_ADMIN_EMAILS=admin@example.com

# 앱 번들 ID 에 요구할 프리픽스. 조직 안에서 ID 가 난립하지 않게 합니다.
BUNDLE_ID_PREFIX=com.example
ENFORCE_BUNDLE_ID_PREFIX=true

# 스토어 앱이 인증 콜백을 받을 커스텀 URL 스킴.
# 이 값은 스토어 앱의 Info.plist 에 박히므로 관리자 화면에서 바꿀 수 없습니다.
# 서버 혼자 바꾸면 이미 깔린 앱의 로그인이 깨집니다.
STORE_APP_URL_SCHEME=alley

# --- 서버 주소 ---
PUBLIC_BASE_URL=http://localhost:8080

# --- 서버 이미지 ---
# CI 가 커밋마다 ghcr.io/<소유자>/<레포> 에 이미지를 올립니다 (ADR-0021).
#
# 레포를 클론해서 쓰면 docker-compose.override.yml 이 소스에서 짓기 때문에
# 아래 둘은 건드릴 필요가 없습니다. 서버에 배포할 때만 채웁니다.
#
# 태그는 **움직이지 않는 것**을 쓰세요. main 이나 latest 로 배포하면 다시 받을
# 때마다 다른 것이 뜨고, 지금 무엇이 돌고 있는지 아무도 말할 수 없게 됩니다.
# 버전 태그(1.2.3)나 커밋 SHA(sha-<40자리>)를 적습니다.
# ALLEY_IMAGE=ghcr.io/example/alley-store
# ALLEY_IMAGE_TAG=1.2.3

# --- 데이터베이스 ---
# 호스트 이름이 localhost 인 이유:
# 개발 중에는 서버를 `swift run alley-server serve` 로 띄우고 데이터베이스만
# 컨테이너로 돌리는 경우가 많습니다. 서버까지 `docker compose up` 으로 띄우면
# compose 가 컨테이너 이름(postgres, minio)으로 덮어쓰므로 이 값은 그대로 두면 됩니다.
DATABASE_URL=postgres://alley:alley@localhost:5432/alley

# 기동하면서 마이그레이션을 적용할지. 기본은 꺼짐입니다.
#
# 켜지 마세요. `alley-server migrate` 를 돌리는 것이 권장 경로입니다. 이 값은
# 일회성 명령을 실행할 수단이 없는 플랫폼(컨테이너에 읽기 전용 명령만 허용하고
# 일회성 잡도 띄울 수 없는 곳)을 위한 문입니다.
#
# 켜면 롤아웃마다 마이그레이션이 돌고, 실패하면 서버가 뜨지 않습니다. 여러 대를
# 띄워도 한 대만 돌지만(Postgres advisory lock) 잠금을 기다리는 동안 파드가
# Ready 가 되지 않습니다. 켜기 전에 운영 가이드를 읽으세요.
# MIGRATE_ON_BOOT=false

# --- 오브젝트 스토리지 (S3 호환) ---
# 셀프호스팅은 docker-compose 의 MinIO 를 그대로 씁니다.
# AWS S3 를 쓰려면 S3_ENDPOINT 를 비우고 S3_USE_PATH_STYLE=false 로 두세요.
#
# 주소가 둘입니다. 헷갈리기 쉬우니 무엇이 어디에 쓰이는지 보고 채우세요.
#   S3_ENDPOINT        서버가 스토리지에 붙는 주소. 컨테이너 안에서만 풀리는 이름도 됩니다
#   S3_PUBLIC_ENDPOINT 브라우저와 스토어 앱에 내주는 주소. 밖에서 닿아야 합니다
#
# 로컬 개발은 둘이 같으므로 S3_PUBLIC_ENDPOINT 를 비워두면 S3_ENDPOINT 를 그대로 씁니다.
# 배포 환경에서 서버가 클러스터 안 이름으로 붙는다면 반드시 채우세요. 안 채우면
# 브라우저가 그 이름을 풀지 못해 업로드가 draft 에서 멈춥니다.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=alley-artifacts

# 버킷 안에서 이 서버가 쓸 자리. 비우면 버킷 루트에 씁니다.
# 버킷 하나를 여러 프로젝트가 나눠 쓰고 각자 프리픽스 하나만 소유하는 환경에서 채웁니다.
# 앞뒤 슬래시는 있어도 없어도 같습니다. foo, foo/, /foo/ 가 모두 같은 결과입니다.
#
# **배포할 때 정하고 그 뒤로 바꾸지 마세요.** 이미 올라간 오브젝트는 옛 자리에 그대로
# 있고 계속 읽히지만, 바꾸는 시점에 올리는 중이던 업로드와 서명 잡은 깨집니다.
# S3_KEY_PREFIX=proj-example

# 액세스 키. 둘 다 비우면 SDK 기본 자격증명 체인을 씁니다.
# (AWS_* 환경변수, 웹 아이덴티티 토큰, 인스턴스 메타데이터, ~/.aws 순)
# 인스턴스에 붙은 역할로 인증하는 환경이면 비워두세요.
# 하나만 채우면 서버가 뜨지 않습니다. 설정 실수를 조용히 넘기지 않으려는 것입니다.
S3_ACCESS_KEY_ID=alleyminio
S3_SECRET_ACCESS_KEY=change-me-minio-secret

S3_USE_PATH_STYLE=true

# 발급하는 presigned URL 의 유효 시간(초).
# **임시 자격증명으로 서명하면 이 값은 상한일 뿐입니다.** 서명에 쓴 세션 토큰이 죽으면
# URL 도 함께 죽습니다. 증상은 "업로드 URL 을 받았는데 얼마 뒤 403" 입니다 (ADR-0024).
S3_PRESIGNED_URL_TTL=3600

# 업로드를 시작했다가 완료 통지 없이 버려진 버전(draft)과 그 오브젝트를 지우기까지
# 기다리는 시간입니다. 서버가 한 시간에 한 번 훑습니다.
# S3_PRESIGNED_URL_TTL 보다 반드시 길어야 합니다. 짧으면 아직 올리고 있는 파일의
# 자리를 지우게 됩니다.
DRAFT_RETENTION_HOURS=72

# 브라우저가 스토리지로 직접 올릴 때 스토리지가 허용할 출처.
# docker-compose 의 MinIO 에만 적용됩니다. AWS S3 를 쓰면 버킷 쪽 CORS 설정을 씁니다.
#
# 비워두면 PUBLIC_BASE_URL 을 그대로 씁니다. 웹 콘솔이 서버와 같은 주소에 있으면
# 그것으로 충분하니 대개 손댈 일이 없습니다.
#
# 여러 출처를 허용하려면 쉼표로 구분합니다. 경로 없이 scheme://host:port 형태로
# 적어야 합니다. 끝에 슬래시가 붙으면 브라우저가 보내는 Origin 과 달라져 막힙니다.
# MINIO_CORS_ALLOW_ORIGIN=https://store.example.com

# --- 로그인 공급자 (OIDC) ---
# 표준 OIDC 를 말하는 곳이면 무엇이든 됩니다 (ADR-0047). issuer 하나만 주면
# 나머지 주소는 서버가 {issuer}/.well-known/openid-configuration 에서 읽어옵니다.
#
#   Google Workspace     https://accounts.google.com            (기본값)
#   Microsoft Entra ID   https://login.microsoftonline.com/<tenant>/v2.0
#   Okta                 https://<org>.okta.com
#   Keycloak             https://<host>/realms/<realm>
#   Authentik            https://<host>/application/o/<slug>/
#
# 비워두면 Google 입니다. 그 전에 이 제품이 Google 만 쓸 수 있었기 때문이고,
# 이미 돌고 있는 스토어가 설정을 바꾸지 않아도 되도록 둔 값입니다.
# OIDC_ISSUER=https://accounts.google.com

# 공급자에서 발급받은 클라이언트입니다. 옛 이름 GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET 도 그대로 받습니다. 새 이름이 있으면 그쪽을 씁니다.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 공급자에 등록한 리다이렉트 URI 와 **글자까지 같아야** 합니다.
# 경로는 공급자와 무관하게 이 값입니다.
OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- 세션 ---
# 세션 토큰을 서명하는 키입니다. **반드시 무작위 값으로 바꾸세요**: openssl rand -base64 48
#
# 32 바이트보다 짧으면 서버가 뜨지 않습니다. HMAC-SHA256 서명 키라서 해시 출력
# 길이(32 바이트)보다 짧으면 서명을 깨는 비용이 그만큼 내려갑니다. 아래 값은 로컬에서
# 일단 뜨게 하려고 길이만 맞춰둔 것이고, 비밀이 아닙니다.
#
# 바꾸면 이미 나간 세션이 모두 끊깁니다. 사용자는 다시 로그인하면 됩니다.
JWT_SECRET=local-dev-only-replace-me-0000000000000000
SESSION_TTL=604800

# --- App Store Connect (선택) ---
# 인증서 만료 현황과 App ID 등록에 씁니다. 안 채우면 그 화면만 꺼지고 나머지는
# 그대로 동작합니다. 서명 자체는 워커가 자기 키체인의 인증서로 하므로 이 값이
# 없어도 배포는 됩니다.
#
# App Store Connect > 사용자 및 액세스 > 통합 에서 키를 발급받으세요.
# ASC_PRIVATE_KEY 는 내려받은 .p8 파일의 내용을 그대로 넣습니다.
# 한 줄로 넣어야 하면 줄바꿈을 \n 으로 바꿔도 됩니다.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY=
