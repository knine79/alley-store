# Alley 서버 설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#
# 이 서버는 어떤 조직에도 묶여 있지 않습니다.
# 조직 고유값은 전부 아래 환경변수로만 들어옵니다.

# --- 스토어 브랜딩 ---
# 아래 다섯 항목(STORE_NAME ~ ENFORCE_BUNDLE_ID_PREFIX)은 데이터베이스에 설정 행이
# 아직 없을 때 한 번만 쓰이는 초기값입니다. 행이 생긴 뒤로는 관리자 화면에서 바꾸고
# 이 파일을 고쳐도 아무 일도 일어나지 않습니다. 자세한 경계는 ADR-0011 을 보세요.
STORE_NAME=Alley
# STORE_LOGO_URL=https://example.com/logo.png
# STORE_ACCENT_COLOR=#3478F6

# 로그인을 허용할 이메일 도메인. 쉼표로 구분합니다.
# 비워두면 도메인 제한 없이 누구나 로그인할 수 있으니 운영 환경에서는 반드시 설정하세요.
ALLOWED_EMAIL_DOMAINS=example.com

# 최초 기동 시 admin 으로 승격할 계정.
# 관리자가 0명일 때 첫 관리자를 만드는 값이라 관리자 화면에 둘 수 없습니다.
INITIAL_ADMIN_EMAILS=admin@example.com

# 앱 번들 ID 에 요구할 프리픽스. 조직 안에서 ID 가 난립하지 않게 합니다.
BUNDLE_ID_PREFIX=com.example
ENFORCE_BUNDLE_ID_PREFIX=true

# 스토어 앱이 인증 콜백을 받을 커스텀 URL 스킴.
# 이 값은 스토어 앱의 Info.plist 에 박히므로 관리자 화면에서 바꿀 수 없습니다.
# 서버 혼자 바꾸면 이미 깔린 앱의 로그인이 깨집니다.
STORE_APP_URL_SCHEME=alley

# --- 서버 주소 ---
PUBLIC_BASE_URL=http://localhost:8080

# --- 데이터베이스 ---
# 호스트 이름이 localhost 인 이유:
# 개발 중에는 서버를 `swift run alley-server serve` 로 띄우고 데이터베이스만
# 컨테이너로 돌리는 경우가 많습니다. 서버까지 `docker compose up` 으로 띄우면
# compose 가 컨테이너 이름(postgres, minio)으로 덮어쓰므로 이 값은 그대로 두면 됩니다.
DATABASE_URL=postgres://alley:alley@localhost:5432/alley

# --- 오브젝트 스토리지 (S3 호환) ---
# 셀프호스팅은 docker-compose 의 MinIO 를 그대로 씁니다.
# AWS S3 를 쓰려면 S3_ENDPOINT 를 비우고 S3_USE_PATH_STYLE=false 로 두세요.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alley-artifacts
S3_ACCESS_KEY_ID=alleyminio
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL=3600

# 브라우저가 스토리지로 직접 올릴 때 스토리지가 허용할 출처.
# docker-compose 의 MinIO 에만 적용됩니다. AWS S3 를 쓰면 버킷 쪽 CORS 설정을 씁니다.
#
# 비워두면 PUBLIC_BASE_URL 을 그대로 씁니다. 웹 콘솔이 서버와 같은 주소에 있으면
# 그것으로 충분하니 대개 손댈 일이 없습니다.
#
# 여러 출처를 허용하려면 쉼표로 구분합니다. 경로 없이 scheme://host:port 형태로
# 적어야 합니다. 끝에 슬래시가 붙으면 브라우저가 보내는 Origin 과 달라져 막힙니다.
# MINIO_CORS_ALLOW_ORIGIN=https://store.example.com

# --- Google OAuth ---
# Google Cloud Console 에서 OAuth 클라이언트를 발급받아 채우세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- 세션 ---
# 운영 환경에서는 반드시 무작위 값으로 바꾸세요: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret
SESSION_TTL=604800

# --- App Store Connect (선택) ---
# 인증서 만료 현황과 App ID 등록에 씁니다. 안 채우면 그 화면만 꺼지고 나머지는
# 그대로 동작합니다. 서명 자체는 워커가 자기 키체인의 인증서로 하므로 이 값이
# 없어도 배포는 됩니다.
#
# App Store Connect > 사용자 및 액세스 > 통합 에서 키를 발급받으세요.
# ASC_PRIVATE_KEY 는 내려받은 .p8 파일의 내용을 그대로 넣습니다.
# 한 줄로 넣어야 하면 줄바꿈을 \n 으로 바꿔도 됩니다.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY=
