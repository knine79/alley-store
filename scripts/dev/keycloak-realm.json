{
  "realm": "alley",
  "enabled": true,
  "displayName": "Alley 개발용",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "alley",
      "name": "Alley 스토어 (개발용)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "alley-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/auth/google/callback",
        "http://127.0.0.1:8080/auth/google/callback"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*##http://127.0.0.1:8080/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "앨리스",
      "lastName": "김",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "밥",
      "lastName": "이",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ]
}
