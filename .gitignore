# Swift Package Manager
.build/
# 빌드 디렉터리를 다른 곳으로 심볼릭 링크한 워크트리에서는 위 규칙이 걸리지 않는다.
.build
.swiftpm/
*.resolved.bak

# Xcode
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# 서명 자산. 어떤 경우에도 레포에 들어오면 안 된다.
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
AuthKey_*.p8

# 설정과 비밀값
.env
.env.*
!.env.example
# docker-compose.override.yml 은 로컬 개발 빌드 설정이라 커밋합니다.
# 자기 머신에만 둘 구성은 *.local.yml 로 만들고 COMPOSE_FILE 에 얹으세요.
*.local.yml

# 워커 작업 디렉터리
.alley-work/

# 이미지에 딸려 보내는 베이스 번들 (ADR-0048). CI 가 이미지를 만들 때 이 자리에
# 넣는다. macOS 에서 컴파일한 500KB 바이너리라 커밋하지 않는다.
#
# **여기에 zip 을 두면 `swift test` 가 네 개 깨진다.** "이미지에 번들이 없을 때"를
# 보는 테스트들이 이 자리를 직접 읽는다. CI 는 테스트를 먼저 돌리고 이미지를 나중에
# 만들어서 그 자리가 늘 비어 있다. 운영과 같은 화면을 로컬에서 보려고 넣었다면,
# 테스트를 돌리기 전에 빼야 한다.
Resources/StoreAppBundle/*.zip

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# 에디터
.idea/
*.swp
*.swo
.vscode/

# 에이전트 작업 상태 (설계 문서는 docs/ 로 옮겨 커밋한다)
.omc/
