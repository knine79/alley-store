#extend("layout"):
#export("content"):

<!-- CLI 가 브라우저를 열어 여기로 보낸다 (ADR-0064). 누르면 일회용 코드가
     127.0.0.1 로 돌아가고, CLI 가 그것을 사람 토큰으로 바꾼다. -->
<h1 class="page-title">기기 연결</h1>
<p class="page-lead">
    이 기기에서 <strong>#(page.store.name)</strong> 를 쓰려고 합니다. 연결하면
    이 기기가 <strong>#(userName)</strong> 님으로 앱을 올리고 서명 결과를 읽습니다.
</p>

#if(error):
<p class="notice notice-error" role="alert">#(error)</p>
#endif

<section class="section">
    <p class="fact-line">
        <span class="fact-label">기기</span>
        <span class="fact-value"><code>#(device)</code></span>
        <span class="fact-label">계정</span>
        <span class="fact-value">#(userName) (#(email))</span>
        <span class="fact-label">수명</span>
        <span class="fact-value">#(lifetimeDays)일</span>
    </p>

    <p class="section-lead">
        앱을 지우거나 사람을 떼는 것은 내주지 않습니다. 돌이킬 수 없는 일은 화면에서
        사람이 합니다. 연결한 기기는 <a href="/me/tokens">내 토큰</a>에서 언제든 폐기할
        수 있고, 수명이 지나면 다시 연결해야 합니다.
    </p>

    <form class="form" method="post" action="/auth/cli">
        <!-- 주소에 실려 온 값을 그대로 돌려보낸다. CLI 가 기다리는 자리와, 남이
             끼어들지 않았는지 대조할 값이다. -->
        <input type="hidden" name="port" value="#(port)">
        <input type="hidden" name="state" value="#(state)">
        <input type="hidden" name="device" value="#(device)">
        <div class="form-actions">
            <button class="button button-primary" type="submit">연결</button>
            <a class="button" href="/">취소</a>
        </div>
    </form>
</section>

#endexport
#endextend
