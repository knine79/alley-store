#extend("layout"):
#export("content"):
<div class="page-head">
    <div>
        <h1 class="page-title">앱</h1>
        <p class="page-lead">
            #if(canRegister):등록된 앱과 준비 중인 앱을 모두 봅니다.#else:출시된 앱을 내려받을 수 있습니다.#endif
        </p>
    </div>
    #if(canRegister):
    <a class="button button-primary" href="/apps/new">새 앱</a>
    #endif
</div>

<!-- 스토어 앱은 목록에 넣지 않는다. 다른 앱을 받는 도구라 같은 줄에 서면 안 된다.
     대신 받는 자리는 남긴다. 스토어 앱이 없는 사람에게는 이것이 유일한 입구다. -->
#if(storeApp):
<p class="notice notice-hint">
    <strong>#(storeApp.name)</strong> 으로 앱을 받고 업데이트합니다. 아직 없다면
    <a href="#(storeApp.downloadPath)">여기서 받으세요</a> (#(storeApp.version)).
    <!-- 이 화면은 앱을 올리는 사람이 보는 곳이다. 받으러 오는 사람에게 콘솔
         주소를 알려주면 개발자용 화면에 먼저 떨어지므로, 사내 문서에 적을
         주소를 따로 내준다 (ADR-0049). -->
    <br>
    다른 사람에게는 로그인 없이 받는
    <a href="#(storeApp.publicURL)"><code>#(storeApp.publicURL)</code></a> 를 알려주세요.
</p>
#endif

<!-- 등록이 끝나지 않은 앱. 목록에는 안 넣지만 올린 사람이 찾아갈 길은 남긴다.
     워커가 실패하면 이 줄이 유일한 입구다 (ADR-0034). -->
#if(count(pendingApps) > 0):
<p class="notice notice-warn">
    아직 확인 중인 등록이 #(count(pendingApps))개 있습니다. 올린 파일에서 번들 ID 를
    읽으면 목록에 나타납니다.
    #for(app in pendingApps):
    <a href="/apps/#(app.id)">#(app.name)</a>#if(!isLast): · #endif
    #endfor
</p>
#endif

#if(count(apps) == 0):
<div class="empty">
    <p>아직 등록된 앱이 없습니다.</p>
    #if(canRegister):
    <p class="empty-note">첫 앱을 등록하면 여기에 표시됩니다.</p>
    #endif
</div>
#else:
<ul class="card-list">
    #for(app in apps):
    <li>
        <a class="card" href="/apps/#(app.id)">
            <!-- 아이콘은 번들에서 뽑아둔 것이다. 없는 앱은 이름 첫 글자를 대신
                 그린다. 빈 사각형을 두면 "덜 만들어진 앱" 처럼 보인다. -->
            <span class="card-icon" aria-hidden="true">
                #if(app.iconURL):
                <img src="#(app.iconURL)" alt="">
                #else:
                <span class="card-icon-letter">#(app.initial)</span>
                #endif
            </span>

            <span class="card-body">
                <span class="card-head">
                    <span class="card-title">#(app.name)</span>
                    <code class="card-id">#(app.bundleID)</code>
                </span>
                #if(app.summary):
                <span class="card-summary">#(app.summary)</span>
                #endif
                <span class="card-meta">
                    #if(app.latestReleasedVersion):
                    <span class="card-release">#(app.latestReleasedVersion) 출시됨</span>
                    #else:
                    <span class="card-quiet">출시본 없음</span>
                    #endif
                    #if(app.ratingAverage):
                    <span class="rating-summary">★ #(app.ratingAverage) <span class="rating-count">(#(app.ratingCount))</span></span>
                    #endif
                    #if(app.category):<span class="card-category">#(app.category)</span>#endif
                </span>
            </span>
        </a>
    </li>
    #endfor
</ul>
#endif
#endexport
#endextend
