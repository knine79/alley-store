#extend("layout"):
#export("content"):
<div class="page-head">
    <div>
        <h1 class="page-title">#(page.appsLabel)</h1>
        <p class="page-lead">
            #if(canRegister):등록된 앱과 준비 중인 앱을 모두 봅니다.#else:출시된 앱을 내려받을 수 있습니다.#endif
        </p>
    </div>
    #if(canRegister):
    <a class="button button-primary" href="/apps/new">새 앱</a>
    #endif
</div>

<!-- 스토어 앱은 목록에 넣지 않는다. 다른 앱을 받는 도구라 같은 줄에 서면 안 된다.
     대신 받는 자리는 남긴다. 스토어 앱이 없는 사람에게는 이것이 유일한 입구다. -->
#if(storeApp):
<p class="notice notice-hint">
    앱 설치와 업데이트는 <strong>#(storeApp.name)</strong> 앱으로 합니다.
    <a href="#(storeApp.path)">여기서 다운로드 받으세요</a> (#(storeApp.version)).
</p>
#endif

<!-- 등록이 끝나지 않은 앱. 목록에는 안 넣지만 올린 사람이 찾아갈 길은 남긴다.
     워커가 실패하면 이 줄이 유일한 입구다 (ADR-0034). -->
#if(count(pendingApps) > 0):
<p class="notice notice-warn">
    아직 확인 중인 등록이 #(count(pendingApps))개 있습니다. 올린 파일에서 번들 ID 를
    읽으면 목록에 나타납니다.
    #for(app in pendingApps):
    <a href="/apps/#(app.id)">#(app.name)</a>#if(!isLast): · #endif
    #endfor
</p>
#endif

<!-- 검색·정렬·분류 (이슈 #56). 서버가 거르고 늘어놓는 GET 폼이라 스크립트 없이
     되고, 조건이 주소에 남아 새로 고치거나 공유해도 같은 목록이 나온다. 규칙은
     스토어 앱과 같은 함수다 (`CatalogFilter`). -->
#if(totalCount > 0):
<form class="form-inline list-filter" method="get" action="/apps" role="search">
    <label class="field">
        <span class="field-label">검색</span>
        <input class="input" type="search" name="q" value="#(query)"
               placeholder="이름, 번들 ID, 태그, 개발자, 설명" autocomplete="off">
    </label>
    #if(count(categoryOptions) > 0):
    <label class="field field-compact">
        <span class="field-label">분류</span>
        <select class="input" name="category">
            <option value="">모든 분류</option>
            #for(option in categoryOptions):
            <option value="#(option.value)"#if(option.selected): selected#endif>#(option.title)</option>
            #endfor
        </select>
    </label>
    #endif
    <label class="field field-compact">
        <span class="field-label">정렬</span>
        <select class="input" name="sort">
            #for(option in sortOptions):
            <option value="#(option.value)"#if(option.selected): selected#endif>#(option.title)</option>
            #endfor
        </select>
    </label>
    <button class="button" type="submit">보기</button>
    #if(isNarrowed):
    <a class="button button-quiet" href="/apps">조건 지우기</a>
    #endif
</form>
#endif

#if(totalCount == 0):
<div class="empty">
    <p>아직 등록된 앱이 없습니다.</p>
    #if(canRegister):
    <p class="empty-note">첫 앱을 등록하면 여기에 표시됩니다.</p>
    #endif
</div>
#elseif(count(apps) == 0):
<!-- 무엇으로 찾았는지를 그대로 말한다. 어디까지 찾는지도 알려야 오타인지 범위
     밖인지 가늠할 수 있다. -->
<div class="empty">
    <p>#(noMatch)</p>
    <p class="empty-note">이름, 번들 ID, 태그, 개발자 이름, 소개와 설명에서 찾습니다.
        <a href="/apps">조건 지우기</a></p>
</div>
#else:
<ul class="card-list">
    #for(app in apps):
    <li>
        <a class="card" href="/apps/#(app.id)">
            <!-- 아이콘은 번들에서 뽑아둔 것이다. 없는 앱은 이름 첫 글자를 대신
                 그린다. 빈 사각형을 두면 "덜 만들어진 앱" 처럼 보인다. -->
            <span class="card-icon" aria-hidden="true">
                #if(app.iconURL):
                <img src="#(app.iconURL)" alt="">
                #else:
                <span class="card-icon-letter">#(app.initial)</span>
                #endif
            </span>

            <span class="card-body">
                <span class="card-head">
                    <span class="card-title">#(app.name)</span>
                    <code class="card-id">#(app.bundleID)</code>
                </span>
                #if(app.summary):
                <span class="card-summary">#(app.summary)</span>
                #endif
                <span class="card-meta">
                    #if(app.latestReleasedVersion):
                    <span class="card-release">#(app.latestReleasedVersion) 출시됨</span>
                    #else:
                    <span class="card-quiet">출시본 없음</span>
                    #endif
                    #if(app.ratingAverage):
                    <span class="rating-summary">★ #(app.ratingAverage) <span class="rating-count">(#(app.ratingCount))</span></span>
                    #endif
                    #if(app.category):<span class="card-category">#(app.category)</span>#endif
                </span>
            </span>
        </a>
    </li>
    #endfor
</ul>
#endif
#endexport
#endextend
