#extend("layout"):
#export("content"):
<div class="page-head">
    <div>
        <h1 class="page-title">앱</h1>
        <p class="page-lead">
            #if(canRegister):등록된 앱과 준비 중인 앱을 모두 봅니다.#else:출시된 앱을 내려받을 수 있습니다.#endif
        </p>
    </div>
    #if(canRegister):
    <a class="button button-primary" href="/apps/new">새 앱</a>
    #endif
</div>

<!-- 등록이 끝나지 않은 앱. 목록에는 안 넣지만 올린 사람이 찾아갈 길은 남긴다.
     워커가 실패하면 이 줄이 유일한 입구다 (ADR-0034). -->
#if(count(pendingApps) > 0):
<p class="notice notice-warn">
    아직 확인 중인 등록이 #(count(pendingApps))개 있습니다. 서명 워커가 번들을 열어
    번들 ID 를 읽으면 목록에 나타납니다.
    #for(app in pendingApps):
    <a href="/apps/#(app.id)">#(app.name)</a>#if(!isLast): · #endif
    #endfor
</p>
#endif

#if(count(apps) == 0):
<div class="empty">
    <p>아직 등록된 앱이 없습니다.</p>
    #if(canRegister):
    <p class="empty-note">첫 앱을 등록하면 여기에 표시됩니다.</p>
    #endif
</div>
#else:
<ul class="card-list">
    #for(app in apps):
    <li>
        <a class="card" href="/apps/#(app.id)">
            <span class="card-head">
                <span class="card-title">#(app.name)</span>
                <code class="card-id">#(app.bundleID)</code>
            </span>
            #if(app.summary):
            <span class="card-summary">#(app.summary)</span>
            #endif
            <span class="card-meta">
                #if(app.latestReleasedVersion):
                <span class="card-release">#(app.latestReleasedVersion) 출시됨</span>
                #else:
                <span class="card-quiet">출시본 없음</span>
                #endif
                #if(app.ratingAverage):
                <span class="rating-summary">★ #(app.ratingAverage) <span class="rating-count">(#(app.ratingCount))</span></span>
                #endif
                #if(app.category):<span class="card-category">#(app.category)</span>#endif
            </span>
        </a>
    </li>
    #endfor
</ul>
#endif
#endexport
#endextend
