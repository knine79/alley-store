#extend("layout"):
#export("content"):
<!-- 발급은 리다이렉트하지 않는다. 원문이 이 응답에만 있어서다. 새로고침이 폼을
     다시 보내면 90일짜리 토큰이 하나 더 생기므로 주소를 목록으로 바꿔둔다
     (`no-resubmit.js`). 서버도 같은 이름을 거절한다. -->
<div hidden data-resubmit-guard="/me/tokens"></div>
<h1 class="page-title">내 토큰</h1>
<p class="page-lead">
    코딩 에이전트가 나 대신 스토어를 다룰 때 쓰는 값입니다. 내가 화면에서 할 수 있는
    것은 이 토큰으로도 됩니다. 90일이면 만료되고, 만료 일주일 전에 알려드립니다.
</p>

#if(error):
<p class="notice notice-error">#(error)</p>
#endif

#if(issued):
<div class="token-box">
    <p class="token-title">새 토큰</p>
    <code class="token-value">#(issued)</code>
    <p class="token-note">
        <strong>이 화면을 벗어나면 다시 볼 수 없습니다.</strong> 서버는 해시만 저장합니다.
        잃어버리면 이 토큰을 폐기하고 새로 발급하세요.
    </p>
</div>
#endif

<section class="section">
    <h2 class="section-title">발급한 토큰</h2>
#if(count(tokens) == 0):
<div class="empty">
    <p>쓸 수 있는 토큰이 없습니다.</p>
    <p class="empty-note">아래에서 만들면 됩니다. 쓰는 곳마다 따로 만들면 하나를 끊어도 나머지는 그대로입니다.</p>
</div>
#else:
<div class="table-scroll">
<table class="table">
    <thead>
        <tr>
            <th class="table-fill">이름</th>
            <th class="table-tight">발급</th>
            <th class="table-tight">만료</th>
            <th class="table-tight">마지막 사용</th>
            <th class="table-tight"><span class="visually-hidden">폐기</span></th>
        </tr>
    </thead>
    <tbody>
        #for(token in tokens):
        <tr>
            <td class="table-fill table-strong">
                #(token.name)
                #if(token.blocked):<span class="badge badge-failed">#(token.blocked)</span>#endif
            </td>
            <td class="table-tight table-muted"><time datetime="#(token.createdAt.iso)" data-date-only="#(token.createdAt.dateOnly)">#(token.createdAt.display)</time></td>
            <td class="table-tight table-muted"><time datetime="#(token.expiresAt.iso)" data-date-only="#(token.expiresAt.dateOnly)">#(token.expiresAt.display)</time></td>
            <!-- 안 쓰는 토큰을 가려내는 단서다. 끊어도 되는지 판단할 것이 이것뿐이다. -->
            <td class="table-tight table-muted">
                #if(token.lastUsedAt):<time datetime="#(token.lastUsedAt.iso)" data-date-only="#(token.lastUsedAt.dateOnly)">#(token.lastUsedAt.display)</time>#else:쓴 적 없음#endif
            </td>
            <td class="table-tight">
                #if(token.isUsable):
                <form class="row-form" method="post" action="/me/tokens/#(token.id)/revoke">
                    <button class="button" type="submit">폐기</button>
                </form>
                #else:
                <span class="table-muted">-</span>
                #endif
            </td>
        </tr>
        #endfor
    </tbody>
</table>
</div>
#endif

    <!-- 90일이면 다 만료된다. 한 목록에 두면 시간이 갈수록 죽은 줄이 쌓여서
         "마지막 사용" 을 읽을 수 없게 된다. 기록은 남기되 접어둔다. -->
    #if(count(retired) > 0):
    <details class="archive">
        <summary>지난 토큰 #count(retired)개 보기</summary>
        <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="table-fill">이름</th>
                    <th class="table-tight">상태</th>
                    <th class="table-tight">만료</th>
                    <th class="table-tight">마지막 사용</th>
                </tr>
            </thead>
            <tbody>
                #for(token in retired):
                <tr>
                    <td class="table-fill table-muted">#(token.name)</td>
                    <td class="table-tight"><span class="badge badge-failed">#(token.blocked)</span></td>
                    <td class="table-tight table-muted"><time datetime="#(token.expiresAt.iso)" data-date-only="#(token.expiresAt.dateOnly)">#(token.expiresAt.display)</time></td>
                    <td class="table-tight table-muted">
                        #if(token.lastUsedAt):<time datetime="#(token.lastUsedAt.iso)" data-date-only="#(token.lastUsedAt.dateOnly)">#(token.lastUsedAt.display)</time>#else:쓴 적 없음#endif
                    </td>
                </tr>
                #endfor
            </tbody>
        </table>
        </div>
    </details>
    #endif

    <form class="form" method="post" action="/me/tokens">
        <label class="field">
            <span class="field-label">이름</span>
            <input class="input" type="text" name="name" required
                   placeholder="노트북 Claude Code" autocomplete="off">
            <span class="field-note">
                어디에 넣을 것인지 적으세요. 나중에 무엇을 끊을지 고를 때 이 이름만 보입니다.
            </span>
        </label>
        <button class="button button-primary" type="submit">발급</button>
    </form>
</section>
#endexport
#endextend
