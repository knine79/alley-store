#extend("layout"):
#export("content"):
<h1 class="page-title">내 알림</h1>
<p class="page-lead">
    나에게 오는 알림만 여기서 정합니다. 앱 채널로 가는 알림은 앱 상세의
    <strong>알림</strong> 에서 앱마다 따로 답니다.
</p>

#if(saved):
<p class="notice notice-ok">저장했습니다.</p>
#endif

<section class="section">
    <h2 class="section-title">Slack DM</h2>

    <!-- **켜기 전에 닿는지 보여준다.** 스토어 계정과 Slack 계정의 이메일이 다르면
         찾지 못하는데, 그 사실을 처음 알림이 날 때 알게 되면 늦다. 그때는 알림이
         안 온 것과 실패가 없는 것이 겉으로 같다. -->
    #if(delivery.isUsable):
    <p class="fact-line">
        <span class="fact-label">받는 곳</span>
        <span class="fact-value">#(delivery.detail)</span>
    </p>
    #else:
    <p class="notice notice-warn">#(delivery.detail)</p>
    #endif

    <form class="form" method="post" action="/me/notifications">
        <fieldset class="choice-group">
            <legend class="visually-hidden">받을 알림</legend>

            <!-- 체크박스는 꺼져 있으면 아예 보내지지 않는다. 서버가 값의 유무로 읽는다. -->
            <label class="choice">
                <input type="checkbox" name="signingFailure"
                       #if(signingFailure):checked#endif>
                <span>
                    <span class="choice-name">내가 올린 버전의 서명이 실패했을 때</span>
                    <span class="choice-note">
                        내가 올린 것만 옵니다. 실패는 올린 사람이 고쳐야 해서 기본으로
                        켜져 있습니다.
                    </span>
                </span>
            </label>

            <label class="choice">
                <input type="checkbox" name="feedback" #if(feedback):checked#endif>
                <span>
                    <span class="choice-name">내가 올릴 수 있는 앱에 피드백이 왔을 때</span>
                    <span class="choice-note">
                        앱 하나를 여럿이 맡으면 각자에게 따로 갑니다. 팀이 함께 보려면
                        앱 채널 쪽이 낫습니다.
                    </span>
                </span>
            </label>
        </fieldset>

        <div class="form-actions">
            <button class="button button-primary" type="submit">저장</button>
        </div>
    </form>
</section>

#endexport
#endextend
