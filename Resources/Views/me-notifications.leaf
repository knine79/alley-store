#extend("layout"):
#export("content"):
<nav class="tabs" aria-label="내 설정">
    <span class="tab tab-current" aria-current="page">내 알림</span>
    <a class="tab" href="/me/tokens">내 토큰</a>
</nav>

<h1 class="page-title">내 알림</h1>
<p class="page-lead">
    앱 관리 화면에서 앱 소식을 개별로 보내지 않고 Slack 채널로 보내도록 설정되어 있는
    경우 이 화면에서 설정한대로 알림을 받지 못할 수 있습니다.
</p>

#if(saved):
<p class="notice notice-ok">저장했습니다.</p>
#endif

<section class="section">
    <!-- **두 묶음이 같은 무게로 선다.** 받는 방법이 사실 한 줄이고 받을 알림만
         체크박스였더니, 하나는 정하는 것이고 하나는 보는 것처럼 읽혔다. 둘 다
         내가 정하는 것이다. -->
    <form class="form" method="post" action="/me/notifications">
        <fieldset class="choice-group">
            <legend class="form-group-title">받는 방법</legend>

            #for(way in ways):
            <!-- 쓸 수 없는 것은 지우지 않고 비활성으로 남긴다. 없애버리면 왜 메일만
                 있는지 알 수 없고, 관리자가 Slack 을 붙이면 생긴다는 것도 모른다. -->
            <label class="choice #if(!way.isUsable):choice-off#endif">
                <input type="checkbox" name="via" value="#(way.value)"
                       #if(way.isChosen):checked#endif
                       #if(!way.isUsable):disabled#endif>
                <span>
                    <span class="choice-name">#(way.label)</span>
                    <span class="choice-note">#(way.detail)</span>
                </span>
            </label>
            #endfor
        </fieldset>

        <fieldset class="choice-group">
            <legend class="form-group-title">받을 알림</legend>

            <!-- 체크박스는 꺼져 있으면 아예 보내지지 않는다. 서버가 값의 유무로 읽는다. -->
            <label class="choice">
                <input type="checkbox" name="signingFailure"
                       #if(signingFailure):checked#endif>
                <span>
                    <span class="choice-name">서명이 실패했을 때</span>
                    <span class="choice-note">
                        내가 올릴 수 있는 앱이면 누가 올린 것이든 옵니다.
                    </span>
                </span>
            </label>

            <label class="choice">
                <input type="checkbox" name="feedback" #if(feedback):checked#endif>
                <span>
                    <span class="choice-name">피드백이 왔을 때</span>
                    <span class="choice-note">내가 올릴 수 있는 앱에 옵니다.</span>
                </span>
            </label>
        </fieldset>

        <div class="form-actions">
            <button class="button button-primary" type="submit">저장</button>
        </div>
    </form>
</section>

#endexport
#endextend
