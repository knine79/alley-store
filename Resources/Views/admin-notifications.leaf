#extend("layout"):
#export("content"):
<h1 class="page-title">알림</h1>
<p class="page-lead">
    워커가 조용해지거나 인증서가 만료될 때 보내는 알림입니다. 앱 하나가 아니라 스토어
    전체가 멈추는 종류라 관리자가 받습니다.
</p>

<!-- 여기서 정하지 않는 것들을 먼저 말한다. 알림이 셋이라 "왜 내 앱 설정이 여기
     없지" 로 헤매기 쉽다. -->
<p class="field-note">
    앱마다 보내는 알림은 <strong>앱 상세의 알림</strong> 에서, 나에게 오는 알림은
    <a href="/me/notifications">내 알림</a> 에서 정합니다.
</p>

#if(error):
<p class="notice notice-error">#(error)</p>
#endif

<!-- 골라둔 곳으로 지금 갈 수 없는 상태. 새로 세운 스토어의 기본값이 관리자 DM 이라
     봇을 넣기 전까지 여기 걸린다. 화면이 말하지 않으면 골라뒀으니 받고 있다고 믿는다. -->
#if(!isBotConfigured):#if(target == "admins"):
<p class="notice notice-error">
    <strong>지금 운영 알림이 아무 데도 가지 않습니다.</strong>
    관리자 DM 으로 정해져 있는데 Slack 봇이 연결되어 있지 않습니다. 아래에서 채널을
    고르거나 <code>SLACK_BOT_TOKEN</code> 을 넣으세요.
</p>
#endif#endif

<section class="section">
    <h2 class="section-title">어디로 보내나</h2>

    <!-- **둘 중 하나만 고른다.** 함께 보내는 선택지를 두지 않는 이유는, 같은 알림이
         두 번 오면 한 번 오는 것보다 빨리 무시당하기 때문이다.

         채널 목록을 이 폼 안에 둔다. 섹션을 나눴더니 "고르는 것" 과 "넣는 것" 이
         따로 있는 것처럼 보여서, 채널을 골라놓고 주소를 안 넣거나 그 반대가 됐다. -->
    <!-- **고를 것이 하나뿐이면 고르게 하지 않는다.**
         봇이 없으면 관리자 DM 은 쓸 수 없다. `disabled` 로 두려다 말았는데, 비활성
         컨트롤은 폼에서 아예 전송되지 않아 저장을 누르면 값이 조용히 뒤집힌다.
         그렇다고 라디오를 하나만 남기면 고를 것이 없는 선택지가 된다.

         그래서 갈래를 나눈다. 둘 다 쓸 수 있으면 고르게 하고, 하나뿐이면 지금
         어디로 가는지만 적는다. -->
    #if(isBotConfigured):
    <form class="form" method="post" action="/admin/notifications/target">
        <fieldset class="choice-group">
            <legend class="visually-hidden">운영 알림을 받을 곳</legend>

            <label class="choice">
                <input type="radio" name="target" value="channel"
                       #if(target == "channel"):checked#endif>
                <span>
                    <span class="choice-name">Slack 채널</span>
                    <span class="choice-note">여러 명이 보고 이력이 남습니다.</span>
                </span>
            </label>

            <!-- **첫 번째 선택지 바로 밑에 둔다.** 채널에 딸린 것이라 그 아래여야
                 한다. 아래 라디오 뒤에 두면 관리자 DM 에 딸린 칸으로 읽힌다. -->
            <div class="field field-attached">
                #extend("admin-notification-channels")
            </div>

            <label class="choice">
                <input type="radio" name="target" value="admins"
                       #if(target == "admins"):checked#endif>
                <span>
                    <span class="choice-name">관리자 DM</span>
                    <span class="choice-note">
                        지금 관리자 #(adminCount)명 에게 각각 보냅니다. 등록할 것이 없어
                        설정을 잊어도 닿습니다.
                    </span>
                </span>
            </label>
        </fieldset>

        <div class="form-actions">
            <button class="button button-primary" type="submit">저장</button>
        </div>
    </form>
    #else:
    <!-- 봇이 없는데 DM 으로 정해져 있다. 새로 세운 스토어의 기본값이라 여기 걸린다.
         고를 것이 하나뿐이니 라디오가 아니라 그리로 옮기는 버튼을 준다. -->
    #if(target == "admins"):
    <p class="fact-line">
        <span class="fact-label">정해진 곳</span>
        <span class="fact-value">관리자 DM (지금 보낼 수 없음)</span>
    </p>
    <form class="form" method="post" action="/admin/notifications/target">
        <input type="hidden" name="target" value="channel">
        <div class="form-actions">
            <button class="button button-primary" type="submit">Slack 채널로 바꾸기</button>
        </div>
    </form>
    #else:
    <p class="fact-line">
        <span class="fact-label">받는 곳</span>
        <span class="fact-value">Slack 채널</span>
    </p>
    #extend("admin-notification-channels")
    #endif

    <p class="field-note">
        Slack 봇을 연결하면 관리자 DM 으로도 보낼 수 있습니다. 서버 환경변수
        <code>SLACK_BOT_TOKEN</code> 을 넣고 다시 띄우세요.
    </p>
    #endif
</section>

<!-- 채널을 고른 동안에만 연다. 관리자 DM 으로 두고 웹훅을 넣게 두면, 넣어놓고
     아무 데도 안 가는 상태가 된다. -->
#if(target == "channel"):
<section class="section">
    <h2 class="section-title">채널 관리</h2>
    <p class="page-lead">
        Slack 채널 설정에서 Incoming Webhook 주소를 받아 넣으세요.
    </p>

    #if(count(targets) > 0):
    <table class="table">
        <thead>
            <tr>
                <th class="table-fill">이름</th>
                <th class="table-tight">마지막 발송</th>
                <th class="table-tight"><span class="visually-hidden">지우기</span></th>
            </tr>
        </thead>
        <tbody>
            #for(item in targets):
            <tr>
                <td class="table-fill">
                    <span class="table-strong">#(item.name)</span>
                    #if(item.lastError):
                    <span class="table-note">#(item.lastError)</span>
                    #endif
                </td>
                <td class="table-tight table-muted">
                    #if(item.lastSentAt):#(item.lastSentAt)#else:—#endif
                </td>
                <td class="table-tight">
                    <form class="row-form" method="post"
                          action="/admin/notifications/targets/#(item.id)/remove">
                        <button class="button button-small button-quiet" type="submit">지우기</button>
                    </form>
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif

    <form class="form card-form" method="post" action="/admin/notifications/targets">
        <label class="field">
            <span class="field-label">이름</span>
            <input class="input" type="text" name="name" placeholder="운영 채널" required>
        </label>
        <label class="field">
            <span class="field-label">Slack 웹훅 주소</span>
            <input class="input" type="url" name="endpoint"
                   placeholder="https://hooks.slack.com/services/..." required>
            <span class="field-note">
                저장하면 다시 보이지 않습니다. 이 주소 자체가 채널에 글을 쓸 수 있는
                자격증명입니다.
            </span>
        </label>
        <div class="form-actions">
            <button class="button button-primary" type="submit">추가</button>
        </div>
    </form>
</section>
#endif

#endexport
#endextend
