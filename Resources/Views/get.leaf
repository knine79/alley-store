#extend("layout"):
#export("content"):
<!-- 로그인 없이 보는 화면이다 (ADR-0049). 받으러 온 사람이 하려는 일은 하나뿐이라
     다른 길을 늘어놓지 않는다. -->
<section class="hero">
    <!-- 받을 앱의 아이콘을 쓴다. 스토어 로고가 아니다. 이 화면에서 사람이 보는
         것은 "내가 받을 앱" 이고, 스토어 브랜드는 머리와 로그인 화면이 말한다. -->
    #if(page.store.appIconURL):
    <img class="hero-logo" src="#(page.store.appIconURL)" alt="">
    #elseif(page.store.logoURL):
    <img class="hero-logo" src="#(page.store.logoURL)" alt="">
    #endif

    #if(app):
    <h1 class="hero-title">#(app.name)</h1>
    <!-- 스토어 이름을 여기 또 적지 않는다. 앱 이름과 스토어 이름이 같은 조직이
         많아서, 그러면 같은 이름이 두 줄 연속으로 나온다. -->
    <p class="hero-lead">
        조직에 배포되는 macOS 앱을 받고 업데이트하는 앱입니다. 받아서 응용 프로그램
        폴더에 옮긴 뒤 열면 됩니다.
    </p>

    <a class="button button-primary button-large" href="#(app.downloadPath)">
        받기
    </a>

    <p class="hero-note">
        #(app.shortVersion) (빌드 #(app.buildNumber))#if(app.minimumSystemVersion): · macOS #(app.minimumSystemVersion) 이상#endif
    </p>

    <!-- 조직 계정이 있어야 쓸 수 있다는 것을 받기 전에 알린다. 받고 나서 알면
         "앱이 잘못됐다" 로 읽힌다. -->
    <p class="hero-note">
        앱을 열면 #(page.store.name) 계정으로 로그인합니다.
    </p>
    #else:
    <h1 class="hero-title">#(page.store.name)</h1>
    <!-- 출시본이 없을 때다. "준비 중" 이라고만 하면 받으러 온 사람이 언제 다시
         와야 하는지 모르므로, 물어볼 곳을 함께 적는다. -->
    <p class="hero-lead">
        아직 받을 수 있는 앱이 없습니다. 관리자가 스토어 앱을 출시하면 여기에
        나타납니다.
    </p>
    #endif
</section>
#endexport
#endextend
