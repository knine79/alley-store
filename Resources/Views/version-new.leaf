#extend("layout"):
#export("content"):
<nav class="breadcrumb"><a href="/apps">앱</a> · <a href="/apps/#(appID)">#(appName)</a></nav>
<h1 class="page-title">새 버전</h1>
<p class="page-lead">
    파일은 이 서버를 거치지 않고 스토리지로 바로 올라갑니다. 창을 닫으면 업로드가 끊깁니다.
</p>

<noscript>
    <p class="notice notice-error">
        이 화면은 브라우저에서 스토리지로 직접 업로드합니다. 자바스크립트를 켜거나
        <code>alley</code> CLI 로 올려주세요.
    </p>
</noscript>

<p class="notice notice-error" id="upload-error" hidden></p>

<form class="form" id="upload-form"
      data-create-url="#(createVersionPath)"
      data-version-root="#(versionRootPath)"
      data-app-url="/apps/#(appID)">
    <fieldset class="form-group">
        <legend class="form-group-title">올릴 파일</legend>

        <label class="field">
            <span class="field-label">앱 파일</span>
            <input class="input" type="file" name="file" required accept=".zip,.dmg,application/zip,application/x-apple-diskimage">
            <span class="field-note">
                zip 또는 dmg. <code>.app</code> 번들은 디렉터리라 그대로 올릴 수 없습니다.
                <strong>zip 으로 올리면</strong> 아래 세 칸을 번들에서 읽어 채웁니다.
                dmg 는 브라우저가 열 수 없어 직접 적으셔야 합니다.
            </span>
            <span class="field-note" id="bundle-read-status" hidden></span>
        </label>
    </fieldset>

    <fieldset class="form-group">
        <legend class="form-group-title">번들이 밝히는 값</legend>

        <label class="field">
            <span class="field-label">버전</span>
            <input class="input" type="text" name="shortVersion" required placeholder="1.0.0"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="field-note">사람이 보는 번호입니다. <code>CFBundleShortVersionString</code> 과 맞추세요.</span>
        </label>

        <label class="field">
            <span class="field-label">빌드 번호</span>
            <!-- `data-suggested` 는 이 값이 서버의 제안이라는 표시다. 사람이 적은
                 값과 구별해야 번들에서 읽은 값으로 덮을 수 있다 (ADR-0030). -->
            <input class="input" type="number" name="buildNumber" required min="1"
                   value="#(suggestedBuildNumber)"
                   data-suggested="#(suggestedBuildNumber)">
            <span class="field-note">같은 앱 안에서 겹칠 수 없습니다. macOS 가 이 값으로 최신을 판단합니다.</span>
        </label>

        <label class="field">
            <span class="field-label">최소 macOS 버전 <span class="field-optional">선택</span></span>
            <input class="input" type="text" name="minimumOSVersion" placeholder="14.0"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
        </label>
    </fieldset>

    <fieldset class="form-group">
        <legend class="form-group-title">사용자에게 알릴 것</legend>

        <label class="field">
            <span class="field-label">릴리즈 노트 <span class="field-optional">선택</span></span>
            <textarea class="input" name="releaseNotes" rows="4"></textarea>
        </label>
    </fieldset>

    <div class="progress-row" id="upload-progress" hidden>
        <progress class="progress" id="upload-bar" max="100" value="0"></progress>
        <span class="progress-label" id="upload-status">준비 중…</span>
    </div>

    <div class="form-actions">
        <a class="button" href="/apps/#(appID)">취소</a>
        <button class="button button-primary" type="submit" id="upload-submit">올리기</button>
    </div>
</form>

<script src="/bundle-info.js?v=#(page.assetVersion)" defer></script>
<script src="/upload.js?v=#(page.assetVersion)" defer></script>
#endexport
#endextend
