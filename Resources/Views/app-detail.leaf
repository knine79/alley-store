#extend("layout"):
#export("content"):
<!-- 토큰 발급은 리다이렉트하지 않는다. 새로고침이 폼을 다시 보내지 않게 이 주소로
     바꿔둔다 (`no-resubmit.js`). -->
<div hidden data-resubmit-guard="/apps/#(app.id)"></div>
<nav class="breadcrumb"><a href="/apps">앱</a></nav>

<!-- 목록에서 아이콘으로 찾아 들어왔는데 상세에 아이콘이 없으면 같은 앱인지
     한 번 더 확인하게 된다. 아이콘은 여기서 올리지 않는다. 번들을 올릴 때
     자동으로 뽑는다 (AppIconController). -->
<div class="identity">
    <span class="identity-icon" aria-hidden="true">
        #if(app.iconURL):
        <img src="#(app.iconURL)" alt="">
        #else:
        <span class="card-icon-letter">#(app.initial)</span>
        #endif
    </span>

    <div class="identity-body">
        <h1 class="page-title">#(app.name)</h1>
        <p class="identity-meta">
            <code>#(app.bundleID)</code>
            #if(app.ratingAverage):
            <span class="rating-summary">★ #(app.ratingAverage) <span class="rating-count">(#(app.ratingCount))</span></span>
            #endif
        </p>
    </div>
</div>

#if(app.isPending):
<p class="notice notice-warn">
    <strong>아직 확인 중입니다.</strong> 올린 파일을 열어 번들 ID 를 읽으면 이 앱이
    무엇인지 정해집니다. 그 전에는 출시할 수 없고 목록에도 나오지 않습니다.
</p>
#endif

#if(app.summary):
<p class="lead-text">#(app.summary)</p>
#endif
#if(app.details):
<p class="body-text">#(app.details)</p>
#endif

#if(downloads):
<div class="stat-row">
    <div class="stat">
        <span class="stat-value">#(downloads.total)</span>
        <span class="stat-label">전체 다운로드</span>
    </div>
    <div class="stat">
        <span class="stat-value">#(downloads.recent)</span>
        <span class="stat-label">최근 #(downloads.recentDays)일</span>
    </div>
    <div class="stat">
        <span class="stat-value">#(downloads.people)</span>
        <span class="stat-label">받아간 사람</span>
    </div>
</div>
#endif

<section class="section">
    <div class="section-head">
        <h2 class="section-title">버전</h2>
        #if(canUpload):
        <a class="button button-primary" href="/apps/#(app.id)/versions/new">새 버전</a>
        #endif
    </div>

    #if(count(versions) == 0):
    <div class="empty">
        <p>아직 올린 버전이 없습니다.</p>
        #if(canUpload):
        <p class="empty-note">새 버전을 올리면 여기에 표시됩니다.</p>
        #endif
    </div>
    #else:
    <table class="table">
        <thead>
            <tr>
                <th class="table-tight">버전</th>
                <th class="table-tight">빌드</th>
                <th class="table-tight">크기</th>
                <th class="table-tight">올린 날짜</th>
                <th class="table-tight">받음</th>
                <th class="table-fill">상태</th>
                #if(canUpload):
                <th class="table-tight"><span class="visually-hidden">출시</span></th>
                #endif
            </tr>
        </thead>
        <tbody>
            #for(version in versions):
            <tr>
                <td class="table-tight table-strong">#(version.shortVersion)</td>
                <td class="table-tight table-muted">#(version.buildNumber)</td>
                <td class="table-tight table-muted">#if(version.fileSize):#(version.fileSize)#else:—#endif</td>
                <td class="table-tight table-muted"><time datetime="#(version.createdAt.iso)" data-date-only="#(version.createdAt.dateOnly)">#(version.createdAt.display)</time></td>
                <td class="table-tight table-muted">#if(version.downloadCount):#(version.downloadCount)#else:—#endif</td>
                <td class="table-fill">
                    <span class="badge badge-#(version.state)">#(version.stateName)</span>
                    <!-- 실패한 줄에서는 로그와 붙은 entitlements 를 아래 실패 줄로
                         내린다. 여기 두면 "실패 → 로그 → (아래) 무엇이 잘못됐나" 가
                         되어, 원인보다 로그를 먼저 만난다. -->
                    #if(!version.hasFailure):
                    #if(version.entitlementKeys):
                    <details class="log">
                        <summary>붙어 있는 entitlements</summary>
                        <pre class="log-body">#(version.entitlementKeys)</pre>
                    </details>
                    #endif
                    #if(version.log):
                    <details class="log">
                        <summary>서명 로그</summary>
                        <pre class="log-body">#(version.log)</pre>
                    </details>
                    #endif
                    #endif
                    #if(version.downloadPath):
                    <span class="table-note">
                        <a href="#(version.downloadPath)">이 버전 받기</a>
                    </span>
                    #endif
                </td>
                #if(canUpload):
                <td class="table-tight">
                    #if(version.isReleased):
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/versions/#(version.id)/unrelease">
                        <button class="button" type="submit">철회</button>
                    </form>
                    #elseif(version.canRelease):
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/versions/#(version.id)/release">
                        <button class="button button-primary" type="submit">출시</button>
                    </form>
                    <!-- 권한이 모자란 실패는 왼쪽 칸의 폼이 대신한다. 여기 버튼을
                         함께 두면 같은 자리에 다시 시도가 둘이 되고, 파일 없이 누른
                         쪽은 똑같이 실패한다. -->
                    #elseif(version.canRetry):#if(!version.needsEntitlements):
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/versions/#(version.id)/retry">
                        <button class="button" type="submit">다시 시도</button>
                    </form>
                    #endif
                    #endif
                </td>
                #endif
            </tr>
            <!-- 실패는 줄 하나를 통째로 쓴다.
                 상태 칸 안에 두면 폭이 좁아 원인 한 문장이 여덟 줄로 접히고, 왼쪽
                 절반은 비어 있다. 읽을 것이 가장 많은 순간에 가장 좁은 칸을 쓰는 셈이라
                 자리를 옮긴다. 워커 잡 목록도 같은 이유로 이렇게 한다.

                 한 덩어리로 묶는 이유. 예전에는 워커 원문·갈래 제목·안내가 각각 흐린
                 작은 글씨로 한 줄씩 섰다. 셋 다 같은 무게라 어느 줄이 "무엇이
                 잘못됐나" 인지 알 수 없었고, 셋이 같은 말을 조금씩 다르게 했다.
                 순서를 하나로 정한다. 갈래 이름 → 무엇이 걸렸나 → 무엇을 하면 되나.
                 원인은 흐리게 쓰지 않는다. 그것을 읽으러 온다. -->
            #if(version.hasFailure):
            <tr class="failure-row">
                <td colspan="#if(canUpload):7#else:6#endif">
                    <div class="failure">
                        <!-- 갈래를 모르는 옛 잡에는 제목이 없다. 그때는 워커 원문만 선다. -->
                        #if(version.failureTitle):
                        <p class="failure-head">
                            <strong class="failure-title">#(version.failureTitle)</strong>
                            <code class="failure-code">#(version.failureCode)</code>
                        </p>
                        #endif
                        #if(version.failureReason):
                        <p class="failure-reason">#(version.failureReason)</p>
                        #endif
                        #if(version.failureAdvice):
                        <p class="failure-advice">#(version.failureAdvice)</p>
                        #endif
                    </div>
                    <!-- 올릴 때는 묻지 않는다. 번들을 열어보고 정말 필요할 때만
                         여기서 받는다 (ADR-0036). -->
                    #if(canUpload):#if(version.needsEntitlements):
                    <form class="attach-form" method="post" enctype="multipart/form-data"
                          action="/apps/#(app.id)/versions/#(version.id)/retry">
                        <label class="field">
                            <span class="field-label">entitlements</span>
                            <input class="input" type="file" name="entitlements" required
                                   accept=".plist,.entitlements,text/xml,application/xml">
                        </label>
                        <button class="button button-primary" type="submit">붙여서 다시 시도</button>
                    </form>
                    <!-- 어디서 찾는지는 아는 사람에게 군말이다. 칸 바로 아래 문단으로
                         펴 두면 폼이 무거워 보이고, 정작 누를 버튼이 그 아래로 밀린다. -->
                    <details class="log">
                        <summary>이 파일 어디 있나</summary>
                        <p class="field-note">#(entitlementsWhereToFind)</p>
                        <p class="field-note">#(entitlementsWhyItWorksLocally)</p>
                        <p class="field-note">
                            CLI 로 올린다면
                            <code>alley upload ... --entitlements build/app.entitlements</code>
                            입니다.
                        </p>
                    </details>
                    <!-- 그 파일이 아예 없는 사람이 있습니다. 애드혹 서명으로 개발하던
                         앱에는 만들 이유가 없었고, 키 이름 하나만 알려주면 XML 뼈대부터
                         막힙니다. 그래서 복사해 바로 쓸 전문을 둡니다.

                         entitlements_rejected 에는 프로필이 필요한 권한인데 프로필이
                         없는 경우도 들어옵니다. 그쪽에는 이 본보기가 답이 아니라서
                         제목에 Electron 을 적고 접어둡니다. -->
                    <details class="log">
                        <summary>Electron 앱인데 entitlements 파일이 없다면</summary>
                        <p class="field-note">#(entitlementsElectronNotes)</p>
                        <pre class="log-body">#(entitlementsElectronTemplate)</pre>
                        <p class="field-note">#(entitlementsElectronCaveat)</p>
                    </details>
                    #endif#endif
                    <!-- 무엇으로 서명했는지. 위의 '붙이는' 칸과 헷갈리지 않게 이름을
                         나눈다. 둘 다 entitlements 라고만 적혀 있으면 같은 것으로 읽힌다. -->
                    #if(version.entitlementKeys):
                    <details class="log">
                        <summary>붙어 있는 entitlements</summary>
                        <pre class="log-body">#(version.entitlementKeys)</pre>
                    </details>
                    #endif
                    #if(version.log):
                    <details class="log">
                        <summary>서명 로그</summary>
                        <pre class="log-body">#(version.log)</pre>
                    </details>
                    #endif
                </td>
            </tr>
            #endif
            #endfor
        </tbody>
    </table>
    #endif
</section>

<!-- 프로필이 필요한 권한을 쓰는 앱에만 나온다 (ADR-0005). 대부분의 맥 앱은
     Developer ID 서명과 공증만으로 배포되고 포털에 등록할 것이 없다. 판단이
     entitlements 를 봐야 서는 일이라, 앱을 만드는 화면이 아니라 여기에 있다. -->
#if(count(profileEntitlements) > 0):
<section class="section">
    <h2 class="section-title">Apple App ID</h2>
    <p class="section-lead">
        이 앱은 프로비저닝 프로필이 있어야 쓸 수 있는 권한을 씁니다. 그런 앱은 Apple
        개발자 계정에 App ID 가 등록돼 있어야 프로필을 받을 수 있습니다.
    </p>

    #if(portalError):
    <p class="notice notice-error">#(portalError)</p>
    #endif
    #if(portalNotice):
    <p class="notice">#(portalNotice)</p>
    #endif

    <p class="fact-line">
        <span class="fact-label">프로필이 필요한 권한</span>
        <span class="fact-value">#for(key in profileEntitlements):<code>#(key)</code> #endfor</span>
    </p>

    #if(isPortalConfigured):
    <div class="section-actions">
        <form method="post" action="/apps/#(app.id)/portal-app-id">
            <button class="button" type="submit">
                <code>#(app.bundleID)</code> 로 App ID 만들기
            </button>
        </form>
    </div>
    <p class="field-note">
        <strong>누르면 Apple 개발자 계정에 실제로 만들어집니다.</strong> 번들 ID 와
        이름은 이 앱에 등록된 값을 그대로 씁니다. 지우는 것은 Apple 화면에서 Account
        Holder 나 Admin 역할만 할 수 있고, 프로비저닝 프로필이 물려 있으면 그것부터
        지워야 합니다.
    </p>
    #else:
    <p class="empty-note">
        App Store Connect 연동이 설정되지 않아 여기서 만들 수 없습니다. 관리 &gt; 앱
        서명 화면에 무엇을 채워야 하는지 적혀 있습니다. 그때까지는 Apple 화면에서
        직접 만들면 됩니다.
    </p>
    #endif
</section>
#endif

#if(canUpload):
<section class="section" id="members">
    <h2 class="section-title">업로드 권한</h2>
    <ul class="person-list">
        #for(member in members):
        <li class="person">
            <span class="person-name">#(member.user.name)</span>
            <span class="person-email">#(member.user.email)</span>
            #if(member.isOwner):<span class="badge">오너</span>#endif
            <!-- 오너는 표에 없어도 언제나 올릴 수 있다. 회수할 것이 없는데 버튼을
                 두면 눌러도 아무 일이 없다. -->
            #if(canManage):#if(!member.isOwner):
            <form class="person-action" method="post"
                  action="/apps/#(app.id)/members/#(member.user.id)/remove">
                <button class="button button-small button-quiet" type="submit">권한 회수</button>
            </form>
            #endif#endif
        </li>
        #endfor
    </ul>

    #if(canManage):
    #if(memberError):
    <p class="notice notice-error">#(memberError)</p>
    #endif

    <!-- **계정이 있는 사람 중에서만 고른다.** 이메일을 손으로 적게 하면 오타가
         "그런 계정이 없습니다" 로 돌아오고, 그게 오타인지 정말 로그인한 적이 없는
         것인지 구분이 안 된다. 찾아서 고르면 둘이 갈린다 - 안 나오면 아직 한 번도
         들어온 적이 없는 사람이다. -->
    <!-- 치는 동안 찾는다 (`member-search.js`). **스크립트는 왕복을 줄일 뿐이다.**
         없으면 이 폼이 그대로 제출되고 서버가 아래를 같은 모양으로 그린다. 그래서
         버튼도 그대로 둔다. -->
    <form class="form-inline" method="get" action="/apps/#(app.id)"
          data-candidates-url="/apps/#(app.id)/member-candidates"
          data-grant-url="/apps/#(app.id)/members"
          data-results="member-results"
          data-server-results="member-results-server">
        <label class="field">
            <span class="field-label">사람 찾기</span>
            <input class="input" type="search" name="member" value="#(memberQuery)"
                   placeholder="이름이나 이메일" autocomplete="off">
        </label>
        <button class="button" type="submit">찾기</button>
    </form>

    <!-- 스크립트가 그리는 자리. 스크립트가 없으면 끝까지 비어 있다. -->
    <div id="member-results"></div>

    <div id="member-results-server">
    #if(memberQuery):
    #if(count(memberCandidates) > 0):
    <ul class="person-list">
        #for(candidate in memberCandidates):
        <li class="person">
            <span class="person-name">#(candidate.name)</span>
            <span class="person-email">#(candidate.email)</span>
            <form class="person-action" method="post" action="/apps/#(app.id)/members">
                <input type="hidden" name="userID" value="#(candidate.id)">
                <button class="button button-small" type="submit">권한 주기</button>
            </form>
        </li>
        #endfor
    </ul>
    #if(memberSearchOverflowed):
    <p class="field-note">결과가 많아 일부만 보입니다. 더 좁혀서 찾아보세요.</p>
    #endif
    #else:
    <!-- 빈 결과의 이유가 둘이다. 한쪽만 적으면 이미 권한이 있는 사람을 찾다가
         "로그인한 적이 없나" 로 잘못 짚는다. -->
    <p class="empty">
        '#(memberQuery)' 로 찾은 사람이 없습니다. 이미 올릴 수 있는 사람과, 이 스토어에
        아직 한 번도 로그인한 적이 없는 사람은 나오지 않습니다.
    </p>
    #endif
    #endif
    </div>
    #endif
</section>
#endif

<section class="section" id="feedback">
    <div class="section-head">
        <h2 class="section-title">피드백</h2>
        #if(app.ratingAverage):
        <span class="table-muted">별점 #(app.ratingAverage) · #(app.ratingCount)명</span>
        #endif
    </div>

    <p class="field-note">
        피드백은 스토어 앱에서 받습니다. 앱을 실제로 받아 쓴 사람만 남길 수 있어야
        해서, 여기서는 읽기만 합니다.
    </p>

    #if(count(feedback) == 0):
    <div class="empty">
        <p>아직 남긴 사람이 없습니다.</p>
    </div>
    #else:
    <ul class="feedback-list">
        #for(entry in feedback):
        <li class="feedback">
            <div class="feedback-head">
                #if(entry.stars):
                <span class="feedback-stars">#(entry.stars)</span>
                #endif
                <span class="feedback-who">
                    #if(entry.authorName):#(entry.authorName)#else:익명#endif
                </span>
                <span class="table-muted">#(entry.versionName)</span>
                <span class="table-muted"><time datetime="#(entry.createdAt.iso)" data-date-only="#(entry.createdAt.dateOnly)">#(entry.createdAt.display)</time></span>
                #if(entry.canDelete):
                <form class="row-form feedback-delete" method="post"
                      action="/apps/#(app.id)/feedback/#(entry.id)/delete">
                    <button class="button button-quiet" type="submit">지우기</button>
                </form>
                #endif
            </div>
            #if(entry.body):
            <p class="feedback-body">#(entry.body)</p>
            #endif
            #if(entry.screenshotURL):
            <a href="#(entry.screenshotURL)" target="_blank" rel="noopener">
                <img class="feedback-shot" src="#(entry.screenshotURL)" alt="첨부한 스크린샷">
            </a>
            #endif
        </li>
        #endfor
    </ul>
    #endif
</section>

#if(canManage):
<section class="section">
    <h2 class="section-title">알림</h2>
    <!-- 어디에 무엇을 넣는지는 칸 옆에서 말한다. 여기서 또 적으면 같은 말이 두 번
         서고, 그러면 둘 다 읽히지 않는다. -->
    <p class="page-lead">
        이 앱에 새 피드백이 오면 알릴 곳입니다. 개인으로 받는 알림은
        <a href="/me/notifications">내 알림</a> 에서 따로 정합니다.
    </p>

    #if(notificationError):
    <p class="notice notice-error">#(notificationError)</p>
    #endif

    #if(count(notificationTargets) == 0):
    <div class="empty">
        <p>알림 대상이 없습니다. 피드백이 와도 아무도 모릅니다.</p>
    </div>
    #else:
    <!-- **어디로 가는지를 보여준다.** 이름만 있으면 지운 대상을 다시 만들 때 무엇이
         있었는지 알 길이 없다. 메일 주소는 자격증명이 아니라 그냥 주소라 가릴 이유가
         없고, 웹훅은 가려야 해서 그 사실을 대신 적는다. -->
    <table class="table">
        <thead>
            <tr>
                <th class="table-tight">이름</th>
                <th class="table-tight">방식</th>
                <th class="table-fill">어디로</th>
                <th class="table-tight"><span class="visually-hidden">삭제</span></th>
            </tr>
        </thead>
        <tbody>
            #for(target in notificationTargets):
            <tr>
                <td class="table-tight table-strong">#(target.name)</td>
                <td class="table-tight table-muted">
                    #if(target.kind == "email"):메일#else:Slack 채널#endif
                </td>
                <td class="table-fill">
                    #if(target.endpoint):
                    <code>#(target.endpoint)</code>
                    #else:
                    <span class="table-muted">저장한 뒤에는 보이지 않습니다</span>
                    #endif
                </td>
                <td class="table-tight">
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/notification-targets/#(target.id)/delete">
                        <button class="button" type="submit">삭제</button>
                    </form>
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif

    <!-- 표 바로 아래에 칸이 붙어 서면 그 칸들이 표의 일부로 읽힌다. 새로 만드는
         자리라는 것을 제목으로 먼저 말한다. -->
    <form class="form" method="post" action="/apps/#(app.id)/notification-targets">
        <div class="form-group">
            <h3 class="form-group-title">대상 추가</h3>

            <!-- **방식을 먼저 고른다.** 그래야 아래 칸에 무엇을 넣는지가 정해진다.
                 이름을 맨 위에 뒀더니 무엇의 이름인지 알 수 없는 칸이 첫 줄에 섰다.

                 **고를 것이 하나뿐이면 고르게 하지 않는다.** 스토어에 메일 설정이
                 없으면 메일 주소를 넣어도 갈 곳이 없다. 그때는 칸을 그리지 않고
                 서버가 웹훅으로 읽는다. -->
            #if(canUseEmailTarget):
            <label class="field">
                <span class="field-label">방식</span>
                <select class="input" name="kind">
                    <option value="slack">Slack 채널</option>
                    <option value="email">메일</option>
                </select>
            </label>
            <label class="field">
                <span class="field-label">받을 곳</span>
                <input class="input" type="text" name="endpoint" required
                       placeholder="https://hooks.slack.com/services/... 또는 team@example.com"
                       autocapitalize="off" autocorrect="off" spellcheck="false">
                <span class="field-note">
                    Slack 채널이면 채널 설정에서 받은 Incoming Webhook 주소를, 메일이면
                    받을 주소를 넣으세요. 웹훅 주소는 그 자체가 채널에 글을 쓸 수 있는
                    자격증명이라 저장하면 다시 보여주지 않습니다.
                </span>
            </label>
            #else:
            <label class="field">
                <span class="field-label">받을 곳</span>
                <input class="input" type="url" name="endpoint" required
                       placeholder="https://hooks.slack.com/services/..."
                       autocapitalize="off" autocorrect="off" spellcheck="false">
                <span class="field-note">
                    Slack 채널 설정에서 받은 Incoming Webhook 주소입니다. 그 자체가
                    채널에 글을 쓸 수 있는 자격증명이라 저장하면 다시 보여주지 않습니다.
                </span>
            </label>
            #endif

            <label class="field">
                <span class="field-label">이름</span>
                <input class="input" type="text" name="name" required placeholder="팀 채널"
                       autocapitalize="off" autocorrect="off" spellcheck="false">
                <span class="field-note">
                    위 목록에서 알아보려고 붙이는 이름입니다. 여기로 보내지는 않습니다.
                </span>
            </label>
        </div>

        <div class="form-actions">
            <button class="button button-primary" type="submit">추가</button>
        </div>
    </form>
</section>
#endif

#if(canManage):
<section class="section">
    <h2 class="section-title">자동 업데이트 피드</h2>
    <p class="page-lead">
        앱에 Sparkle 을 넣으면 스토어 앱 없이도 스스로 업데이트합니다. 여기서 낸 피드
        주소를 앱의 <code>SUFeedURL</code> 에 넣습니다. 이 경로로 받은 것은
        <strong>사용자별 다운로드 이력이 남지 않습니다.</strong>
    </p>

    <!-- 서명이 없으면 피드가 내려와도 Sparkle 이 조용히 아무것도 하지 않는다.
         주소만 알려주고 이 말을 안 하면 그대로 따라 하다 막힌다 (ADR-0057). -->
    #if(sparkle):
    #if(sparkle.blocker):
    <p class="notice notice-warn">#(sparkle.blocker)</p>
    #endif

    #if(sparkle.publicKey):
    <div class="token-box">
        <p class="token-title">이 앱의 <code>SUPublicEDKey</code></p>
        <code class="token-value">#(sparkle.publicKey)</code>
        <p class="token-note">
            앱의 <code>Info.plist</code> 에 이 값을 넣으세요. Sparkle 은 이것으로
            업데이트가 우리가 만든 것인지 확인합니다. 공개키라 숨길 값은 아닙니다.
        </p>
    </div>
    #endif
    #endif

    #if(feedError):
    <p class="notice notice-error">#(feedError)</p>
    #endif

    #if(issuedFeed):
    <div class="token-box">
        <p class="token-title">'#(issuedFeed.name)' 의 피드 주소</p>
        <code class="token-value">#(issuedFeed.feedURL)</code>
        <p class="token-note">
            <strong>이 화면을 벗어나면 다시 볼 수 없습니다.</strong> 주소 안의 토큰은
            해시로만 저장합니다. 이 주소를 아는 사람은 누구나 이 앱의 출시본을 받을 수
            있으니 앱 설정 밖으로 흘리지 마세요.
        </p>
    </div>
    #endif

    #if(count(feedTokens) == 0):
    <div class="empty">
        <p>발급한 피드가 없습니다.</p>
        <p class="empty-note">Sparkle 을 쓰지 않는 앱은 그대로 두면 됩니다.</p>
    </div>
    #else:
    <table class="table">
        <thead>
            <tr>
                <th class="table-fill">이름</th>
                <th class="table-tight">발급</th>
                <th class="table-tight">마지막 사용</th>
                <th class="table-tight">상태</th>
                <th class="table-tight"><span class="visually-hidden">폐기</span></th>
            </tr>
        </thead>
        <tbody>
            #for(token in feedTokens):
            <tr>
                <td class="table-fill table-strong">#(token.name)</td>
                <td class="table-tight table-muted"><time datetime="#(token.issuedAt.iso)" data-date-only="#(token.issuedAt.dateOnly)">#(token.issuedAt.display)</time></td>
                <td class="table-tight table-muted">#if(token.lastUsed):<time datetime="#(token.lastUsed.iso)" data-date-only="#(token.lastUsed.dateOnly)">#(token.lastUsed.display)</time>#else:쓰인 적 없음#endif</td>
                <td class="table-tight">
                    #if(token.isActive):
                    <span class="badge">쓸 수 있음</span>
                    #else:
                    <span class="badge badge-failed">폐기됨</span>
                    #endif
                </td>
                <td class="table-tight">
                    #if(token.isActive):
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/feed-tokens/#(token.id)/revoke">
                        <button class="button" type="submit">폐기</button>
                    </form>
                    #endif
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif

    <!-- **공개키를 하나로 말할 수 없으면 내주지 않는다.** 주소를 내주면 넣고, 넣으면
         된 줄 안다. 위의 경고는 그때 한 줄로 남을 뿐이다 (ADR-0057).

         이미 발급한 것은 위 표에 그대로 있다. 그 주소로 피드는 내려가고, 키를 넣으면
         다음 버전부터 서명이 붙는다. 여기서 막는 것은 새로 내주는 것뿐이다. -->
    #if(sparkle.canIssue):
    <form class="form" method="post" action="/apps/#(app.id)/feed-tokens">
        <label class="field">
            <span class="field-label">피드 이름</span>
            <input class="input" type="text" name="name" required placeholder="sparkle"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
        </label>
        <div class="form-actions">
            <button class="button button-primary" type="submit">피드 주소 발급</button>
        </div>
    </form>
    #else:
    <!-- 고치는 자리가 관리 화면이라 여기로 링크하지 않는다. 이 앱을 맡은 사람이
         관리자가 아니면 눌러도 들어가지 못한다. 누구에게 말해야 하는지만 적는다. -->
    <p class="field-note">
        위 문제를 고치기 전에는 피드 주소를 내주지 않습니다. 지금 내줘도 앱이 그 주소로
        업데이트를 받지 못합니다. 서명 워커에 Sparkle 키를 넣는 것은 스토어 관리자가
        하는 일입니다.
    </p>
    #endif
</section>
#endif

#if(canManage):
<section class="section">
    <h2 class="section-title">배포 토큰</h2>
    <p class="page-lead">
        CI 파이프라인이 이 앱에 버전을 올릴 때 쓰는 토큰입니다. 이 앱에만 통하고,
        받는 것은 할 수 없습니다.
    </p>

    #if(issuedToken):
    <div class="token-box">
        <p class="token-title">'#(issuedToken.name)' 의 토큰</p>
        <code class="token-value">#(issuedToken.value)</code>
        <p class="token-note">
            <strong>이 화면을 벗어나면 다시 볼 수 없습니다.</strong> 서버는 해시만 저장합니다.
            파이프라인의 <code>ALLEY_TOKEN</code> 에 넣으세요.
        </p>
    </div>
    #endif

    #if(count(deployTokens) == 0):
    <div class="empty">
        <p>아직 발급한 토큰이 없습니다.</p>
    </div>
    #else:
    <table class="table">
        <thead>
            <tr>
                <th class="table-fill">이름</th>
                <th class="table-tight">발급</th>
                <th class="table-tight">마지막 사용</th>
                <th class="table-tight">상태</th>
                <th class="table-tight"><span class="visually-hidden">폐기</span></th>
            </tr>
        </thead>
        <tbody>
            #for(token in deployTokens):
            <tr>
                <td class="table-fill table-strong">#(token.name)</td>
                <!-- 폐기한 토큰도 같은 표에 남습니다. 같은 이름으로 다시 발급하면
                     발급 시각 말고는 두 줄을 가릴 단서가 없습니다. -->
                <td class="table-tight table-muted"><time datetime="#(token.issuedAt.iso)" data-date-only="#(token.issuedAt.dateOnly)">#(token.issuedAt.display)</time></td>
                <td class="table-tight table-muted">#if(token.lastUsed):<time datetime="#(token.lastUsed.iso)" data-date-only="#(token.lastUsed.dateOnly)">#(token.lastUsed.display)</time>#else:쓰인 적 없음#endif</td>
                <td class="table-tight">
                    #if(token.isActive):
                    <span class="badge">쓸 수 있음</span>
                    #else:
                    <span class="badge badge-failed">폐기됨</span>
                    #endif
                </td>
                <td class="table-tight">
                    #if(token.isActive):
                    <form class="row-form" method="post"
                          action="/apps/#(app.id)/deploy-tokens/#(token.id)/revoke">
                        <button class="button" type="submit">폐기</button>
                    </form>
                    #endif
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif

    <form class="form" method="post" action="/apps/#(app.id)/deploy-tokens">
        <label class="field">
            <span class="field-label">토큰 이름</span>
            <input class="input" type="text" name="name" required placeholder="github-actions"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="field-note">어느 파이프라인의 것인지 알아볼 이름이면 됩니다.</span>
        </label>
        <div class="form-actions">
            <button class="button button-primary" type="submit">토큰 발급</button>
        </div>
    </form>
</section>
#endif

<!-- 지우기는 맨 아래 따로 둔다. 다른 버튼들 사이에 끼면 실수로 누른다 (ADR-0041). -->
#if(canManage):
<section class="section section-danger">
    <h2 class="section-title">이 앱 지우기</h2>
    <p class="danger-note">버전 #(removal.versions)개와 올린 파일#if(removal.downloads > 0):, 받아간 기록 #(removal.downloads)건#endif이 함께 사라집니다. 되돌릴 수 없습니다.</p>
    #if(removal.needsTypedName):
    <p class="danger-note"><strong>이미 나간 앱입니다.</strong> 받아간 사람의 맥에는 앱이 그대로 남고 새 버전만 오지 않습니다. 지우려면 앱 이름을 적어야 합니다.</p>
    #endif

    <div class="danger-actions">
        <form method="post" action="/apps/#(app.id)/delete"
              data-confirm="#(app.name) 을(를) 지웁니다. 버전 #(removal.versions)개와 올린 파일이 함께 사라집니다. 되돌릴 수 없습니다."
              #if(removal.needsTypedName):data-confirm-match="#(app.name)"#endif>
            <input type="hidden" name="confirmName" value="">
            <button class="button button-danger" type="submit">이 앱 지우기</button>
        </form>
    </div>
</section>
#endif

<!-- 되돌릴 수 없는 폼 앞에 세우는 팝업. `data-confirm` 이 붙은 폼이 쓴다. -->
#if(canManage):
<dialog class="modal" id="confirm-dialog" aria-labelledby="confirm-title">
    <form method="dialog">
        <h2 class="modal-title" id="confirm-title">정말 할까요?</h2>
        <div class="modal-body">
            <p id="confirm-message"></p>
            <label class="field" id="confirm-match-field" hidden>
                <span class="field-label" id="confirm-match-label"></span>
                <input class="input" type="text" id="confirm-match-input"
                       autocapitalize="off" autocorrect="off" spellcheck="false">
            </label>
        </div>
        <!-- 취소가 먼저라 Enter 로 닫으면 아무 일도 없다. Esc 도 마찬가지다. -->
        <div class="modal-actions">
            <button class="button" type="submit" value="cancel">취소</button>
            <button class="button button-danger" type="submit" value="accept" id="confirm-accept">
                지우기
            </button>
        </div>
    </form>
</dialog>

<script src="/confirm.js?v=#(page.assetVersion)" defer></script>
#endif

<!-- 업로드 권한을 줄 사람을 치는 동안 찾는다. 없어도 폼이 그대로 굴러간다. -->
#if(canUpload):
<script src="/member-search.js?v=#(page.assetVersion)" defer></script>
#endif
#endexport
#endextend
