#extend("layout"):
#export("content"):
<h1 class="page-title">역할 관리</h1>
<p class="page-lead">
    한 번이라도 로그인한 계정만 여기 나옵니다. 바뀐 역할은 그 사람의 다음 요청부터 적용됩니다.
</p>

#if(error):
<p class="notice notice-error">#(error)</p>
#endif

<div class="table-scroll">
<table class="table">
    <thead>
        <tr>
            <th class="table-fill">사람</th>
            <th class="table-tight">역할</th>
            <th class="table-tight"><span class="visually-hidden">계정</span></th>
        </tr>
    </thead>
    <tbody>
        #for(person in users):
        <tr>
            <td class="table-fill">
                <span class="table-strong">#(person.name)</span>
                #if(person.isSelf):<span class="badge">나</span>#endif
                #if(person.isActive):#else:<span class="badge badge-failed">끊김</span>#endif
                <span class="table-note">#(person.email)</span>
            </td>
            <td class="table-tight">
                <form class="row-form" method="post" action="/admin/users/#(person.id)/role"
                      data-guard-dirty>
                    <select class="input select" name="role" aria-label="#(person.email) 의 역할"#if(person.isActive):#else: disabled#endif>
                        #for(option in roles):
                        <option value="#(option.value)"#if(option.value == person.role): selected#endif>#(option.name)</option>
                        #endfor
                    </select>
                    <button class="button" type="submit"#if(person.isActive):#else: disabled#endif>변경</button>
                </form>
            </td>
            <!-- 끊는 것과 되살리는 것을 한 칸에 둔다. 지금 상태에 따라 하나만 보인다.
                 자기 계정은 끊을 수 없어서(스스로 로그인을 잃는다) 아예 내지 않는다. -->
            <td class="table-tight">
                #if(person.isActive):
                #if(person.isSelf):
                <span class="table-muted">-</span>
                #else:
                <form class="row-form" method="post" action="/admin/users/#(person.id)/deactivate">
                    <button class="button" type="submit">끊기</button>
                </form>
                #endif
                #else:
                <form class="row-form" method="post" action="/admin/users/#(person.id)/reactivate">
                    <button class="button" type="submit">되살리기</button>
                    <span class="table-note">#(person.deactivatedAt.display) 에 끊음</span>
                </form>
                #endif
            </td>
        </tr>
        #endfor
    </tbody>
</table>
</div>

<p class="page-lead">
    끊은 계정은 로그인도 막히고 이미 열려 있던 세션도 그 자리에서 끊깁니다. 맡고 있던
    앱은 <strong>함께 맡던 사람 중 가장 먼저 들어온 사람</strong>에게 넘어갑니다.
    넘어간 앱은 되살려도 돌아오지 않습니다.
</p>

<!-- 함께 맡던 사람이 없어 넘기지 못한 앱들. 아무나 지목하는 것보다 비워두고
     사람이 정하는 쪽을 골랐다 (ADR-0061). 그 대신 여기 모아 보여준다. -->
#if(count(orphanedApps) > 0):
<section class="section" id="orphaned">
    <h2 class="section-title">주인을 정해야 하는 앱</h2>
    <p class="section-lead">
        오너가 끊긴 계정입니다. 함께 맡던 사람이 없어 자동으로 넘기지 못했습니다.
        정할 때까지 이 앱은 관리자 말고는 아무도 올릴 수 없습니다.
    </p>

    #for(app in orphanedApps):
    <div class="section-danger">
        <h3 class="section-title">#(app.name)</h3>
        <p class="danger-note">
            <code>#(app.bundleID)</code> · 두고 간 사람 <strong>#(app.previousOwner)</strong>
        </p>

        <!-- 앱마다 검색 자리가 따로 있어야 해서 id 를 앱마다 다르게 준다
             (`member-search.js` 는 폼마다 붙는다). 스크립트가 없으면 이 폼이
             그대로 제출되고 서버가 아래를 같은 모양으로 그린다. -->
        <form class="form-inline" method="get" action="/admin/users"
              data-app="#(app.id)"
              data-candidates-url="/apps/#(app.id)/member-candidates"
              data-grant-url="/admin/apps/#(app.id)/owner"
              data-grant-label="오너로 정하기"
              data-results="owner-results-#(app.id)"
              data-server-results="owner-results-server-#(app.id)">
            <!-- 이름을 `member` 로 두는 것은 `member-search.js` 가 그 이름을 찾기
                 때문이다. 화면마다 다른 이름을 쓰면 스크립트도 화면마다 갈린다. -->
            <input type="hidden" name="app" value="#(app.id)">
            <label class="field">
                <span class="field-label">새 오너 찾기</span>
                <input class="input" type="search" name="member" value="#(app.query)"
                       placeholder="이름이나 이메일" autocomplete="off">
            </label>
            <button class="button" type="submit">찾기</button>
        </form>
        <div id="owner-results-#(app.id)"></div>
        <div id="owner-results-server-#(app.id)">
        #if(app.query):
        #if(count(app.candidates) > 0):
        <ul class="person-list">
            #for(candidate in app.candidates):
            <li class="person">
                <span class="person-name">#(candidate.name)</span>
                <span class="person-email">#(candidate.email)</span>
                <form class="person-action" method="post" action="/admin/apps/#(app.id)/owner">
                    <input type="hidden" name="userID" value="#(candidate.id)">
                    <button class="button button-small" type="submit">오너로 정하기</button>
                </form>
            </li>
            #endfor
        </ul>
        #if(app.overflowed):
        <p class="field-note">결과가 많아 일부만 보입니다. 더 좁혀서 찾아보세요.</p>
        #endif
        #else:
        <p class="empty">'#(app.query)' 로 찾은 사람이 없습니다. 끊긴 계정과 아직 한 번도 로그인한 적이 없는 사람은 나오지 않습니다.</p>
        #endif
        #endif
        </div>
    </div>
    #endfor
</section>
#endif

<!-- 치는 동안 찾는다. 없으면 위 폼이 그대로 제출되고 서버가 같은 것을 그린다. -->
<script src="/member-search.js?v=#(page.assetVersion)" defer></script>
#endexport
#endextend
