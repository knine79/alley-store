<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#if(page.title):#(page.title) · #endif#(page.store.name)</title>
    <link rel="stylesheet" href="/console.css?v=#(page.assetVersion)">
    #if(page.store.faviconURL):
    <link rel="icon" type="image/png" href="#(page.store.faviconURL)">
    <link rel="apple-touch-icon" href="#(page.store.faviconURL)">
    #endif
    #if(page.store.accentColor):
    <style>:root { --accent: #(page.store.accentColor); }</style>
    #endif
</head>
<body>
    <header class="chrome">
        <div class="chrome-inner">
            <a class="brand" href="/">
                #if(page.store.logoURL):
                <img class="brand-logo" src="#(page.store.logoURL)" alt="">
                #endif
                <span class="brand-name">#(page.store.name)</span>
            </a>

            #if(page.user):
            <nav class="chrome-nav">
                #if(page.isAdmin):
                <a class="chrome-link" href="/admin/settings">관리</a>
                #endif
                <span class="chrome-user" title="#(page.user.email)">#(page.user.name)</span>
                <form method="post" action="/logout">
                    <button class="button button-quiet" type="submit">로그아웃</button>
                </form>
            </nav>
            #endif
        </div>
    </header>

    <main class="page">
        #extend("admin-nav")
        #import("content")
    </main>

    <!-- 날짜를 보는 사람의 타임존으로 다시 그린다. 없어도 서버가 쓴 값이 남는다. -->
    <script src="/local-time.js?v=#(page.assetVersion)" defer></script>
    <!-- 고른 이미지가 조건에 맞는지 그 자리에서 알려준다. 없어도 서버가 같은 검사를
         하므로 올리는 데 지장이 없다. -->
    <script src="/image-check.js?v=#(page.assetVersion)" defer></script>
    <!-- 되돌리기 어려운 칸을 확인 하나 뒤에 잠가둔다. 없어도 서버가 같은 확인을
         요구하므로 실수로 바뀌지는 않는다. -->
    <script src="/lock-fields.js?v=#(page.assetVersion)" defer></script>
    <!-- 색을 눈으로 고르게 한다. 없어도 값을 손으로 적을 수 있다. -->
    <script src="/color-field.js?v=#(page.assetVersion)" defer></script>
    <!-- 한 번만 보여줄 표시를 주소에서 걷어낸다. 없으면 새로고침할 때마다
         "저장했습니다" 가 다시 뜬다. -->
    <script src="/flash.js?v=#(page.assetVersion)" defer></script>
    <!-- 바뀐 것이 없으면 저장 버튼을 잠근다. 없어도 저장은 되고, 같은 값을 다시
         쓸 뿐이다. -->
    <script src="/dirty-guard.js?v=#(page.assetVersion)" defer></script>
    <!-- 폼을 POST 로 받아 그 자리에서 그린 화면에서만 붙인다. 새로고침이 같은 폼을
         다시 보내는 것을 막는다. 없어도 서버가 같은 이름의 토큰을 거절한다. -->
    #if(page.isFormResult):
    <script src="/no-resubmit.js?v=#(page.assetVersion)" defer></script>
    #endif
</body>
</html>
