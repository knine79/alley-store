<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#if(page.title):#(page.title) · #endif#(page.store.name)</title>
    <link rel="stylesheet" href="/console.css?v=#(page.assetVersion)">
    #if(page.store.faviconURL):
    <link rel="icon" type="image/png" href="#(page.store.faviconURL)">
    <link rel="apple-touch-icon" href="#(page.store.faviconURL)">
    #endif
    #if(page.store.accentColor):
    <style>:root { --accent: #(page.store.accentColor); }</style>
    #endif
</head>
<body>
    <header class="chrome">
        <div class="chrome-inner">
            <a class="brand" href="/">
                #if(page.store.logoURL):
                <img class="brand-logo" src="#(page.store.logoURL)" alt="">
                #endif
                <span class="brand-name">#(page.store.name)</span>
            </a>

            #if(page.user):
            <nav class="chrome-nav">
                #if(page.isAdmin):
                <a class="chrome-link" href="/admin/settings">관리</a>
                #endif
                <span class="chrome-user" title="#(page.user.email)">#(page.user.name)</span>
                <form method="post" action="/logout">
                    <button class="button button-quiet" type="submit">로그아웃</button>
                </form>
            </nav>
            #endif
        </div>
    </header>

    <main class="page">
        #extend("admin-nav")
        #import("content")
    </main>

    <!-- 날짜를 보는 사람의 타임존으로 다시 그린다. 없어도 서버가 쓴 값이 남는다. -->
    <script src="/local-time.js?v=#(page.assetVersion)" defer></script>
    <!-- 고른 이미지가 조건에 맞는지 그 자리에서 알려준다. 없어도 서버가 같은 검사를
         하므로 올리는 데 지장이 없다. -->
    <script src="/image-check.js?v=#(page.assetVersion)" defer></script>
</body>
</html>
