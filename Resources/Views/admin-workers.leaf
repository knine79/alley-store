#extend("layout"):
#export("content"):
<div class="page-head">
    <div>
        <h1 class="page-title">서명 워커</h1>
        <p class="page-lead">
            미서명으로 올라온 버전의 서명과 공증을 대신하는 맥입니다. 인증서는 그 머신의
            키체인에만 있고 이 서버로 올라오지 않습니다.
        </p>
    </div>
    <div class="head-actions">
        <a class="button" href="/admin/settings">스토어 설정</a>
        <a class="button" href="/admin/stats">통계</a>
        <a class="button" href="/admin/users">역할 관리</a>
        <a class="button" href="/admin/portal">개발자 포털</a>
    </div>
</div>

#if(error):
<p class="notice notice-error">#(error)</p>
#endif

#if(issued):
<div class="token-box">
    <p class="token-title">'#(issued.name)' 의 토큰</p>
    <code class="token-value">#(issued.token)</code>
    <p class="token-note">
        <strong>이 화면을 벗어나면 다시 볼 수 없습니다.</strong> 서버는 해시만 저장합니다.
        워커 머신의 <code>ALLEY_WORKER_TOKEN</code> 에 넣으세요. 잃어버리면 새로 발급하고
        이 워커는 폐기하면 됩니다.
    </p>
</div>
#endif

#if(count(workers) == 0):
<div class="empty">
    <p>아직 등록된 워커가 없습니다.</p>
    <p class="empty-note">워커를 등록해야 미서명 업로드가 서명 단계로 넘어갑니다.</p>
</div>
#else:
<table class="table">
    <thead>
        <tr>
            <th class="table-fill">이름</th>
            <th class="table-tight">macOS</th>
            <th class="table-tight">마지막 접속</th>
            <th class="table-tight">상태</th>
            <th class="table-tight"><span class="visually-hidden">폐기</span></th>
        </tr>
    </thead>
    <tbody>
        #for(worker in workers):
        <tr>
            <td class="table-fill table-strong">#(worker.name)</td>
            <td class="table-tight table-muted">#if(worker.osVersion):#(worker.osVersion)#else:—#endif</td>
            <td class="table-tight table-muted">#if(worker.lastSeen):#(worker.lastSeen)#else:접속한 적 없음#endif</td>
            <td class="table-tight">
                #if(worker.isActive):
                #if(worker.isBusy):
                <span class="badge badge-released">작업 중</span>
                #else:
                <span class="badge">대기 중</span>
                #endif
                #else:
                <span class="badge badge-failed">폐기됨</span>
                #endif
            </td>
            <td class="table-tight">
                #if(worker.isActive):
                <form class="row-form" method="post" action="/admin/workers/#(worker.id)/revoke">
                    <button class="button" type="submit">폐기</button>
                </form>
                #endif
            </td>
        </tr>
        #endfor
    </tbody>
</table>
#endif

<section class="section">
    <h2 class="section-title">워커 등록</h2>
    <form class="form" method="post" action="/admin/workers">
        <label class="field">
            <span class="field-label">이름</span>
            <input class="input" type="text" name="name" required placeholder="build-mac-01"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="field-note">어느 머신인지 알아볼 수 있는 이름이면 됩니다. 워커가 접속하면 자기 설정의 이름으로 덮어씁니다.</span>
        </label>
        <div class="form-actions">
            <button class="button button-primary" type="submit">토큰 발급</button>
        </div>
    </form>
</section>
#endexport
#endextend
