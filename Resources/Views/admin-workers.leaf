#extend("layout"):
#export("content"):
<h1 class="page-title">서명 워커</h1>
<p class="page-lead">
    미서명으로 올라온 버전의 서명과 공증을 대신하는 맥입니다. 인증서는 그 머신의
    키체인에만 있고 이 서버로 올라오지 않습니다.
</p>

#if(error):
<p class="notice notice-error">#(error)</p>
#endif

#if(issued):
<div class="token-box">
    <p class="token-title">'#(issued.name)' 의 토큰</p>
    <code class="token-value">#(issued.token)</code>
    <p class="token-note">
        <strong>이 화면을 벗어나면 다시 볼 수 없습니다.</strong> 서버는 해시만 저장합니다.
        워커 머신의 <code>ALLEY_WORKER_TOKEN</code> 에 넣으세요. 잃어버리면 새로 발급하고
        이 워커는 폐기하면 됩니다.
    </p>
</div>
#endif

#if(count(workers) == 0):
<div class="empty">
    <p>아직 등록된 워커가 없습니다.</p>
    <p class="empty-note">워커를 등록해야 미서명 업로드가 서명 단계로 넘어갑니다.</p>
</div>
#else:
<table class="table">
    <thead>
        <tr>
            <th class="table-fill">이름</th>
            <th class="table-tight">워커 버전</th>
            <th class="table-tight">macOS</th>
            <th class="table-tight">마지막 접속</th>
            <th class="table-tight">상태</th>
            <th class="table-tight"><span class="visually-hidden">폐기</span></th>
        </tr>
    </thead>
    <tbody>
        #for(worker in workers):
        <tr>
            <td class="table-fill table-strong">#(worker.name)</td>
            <!-- 낡은 워커는 조용히 엉뚱한 실패를 냅니다. dmg 를 모르는 워커가 dmg 를
                 zip 으로 풀다 "번들 구조 문제" 라고 한 적이 있습니다 (ADR-0042). -->
            <td class="table-tight">
                #if(worker.isStale):
                <span class="badge badge-failed">#(worker.workerVersion)</span>
                #else:
                <span class="table-muted">#(worker.workerVersion)</span>
                #endif
            </td>
            <td class="table-tight table-muted">#if(worker.osVersion):#(worker.osVersion)#else:—#endif</td>
            <td class="table-tight table-muted">#if(worker.lastSeen):#(worker.lastSeen)#else:접속한 적 없음#endif</td>
            <td class="table-tight">
                #if(worker.isActive):
                #if(worker.isBusy):
                <span class="badge badge-released">작업 중</span>
                #else:
                <span class="badge">대기 중</span>
                #endif
                #else:
                <span class="badge badge-failed">폐기됨</span>
                #endif
            </td>
            <td class="table-tight">
                #if(worker.isActive):
                <form class="row-form" method="post" action="/admin/workers/#(worker.id)/revoke">
                    <button class="button" type="submit">폐기</button>
                </form>
                #endif
            </td>
        </tr>
        #endfor
    </tbody>
</table>
#endif

#if(count(jobs) == 0):
#else:
<section class="section">
    <h2 class="section-title">최근 서명 잡</h2>
    <p class="page-lead">
        시도 횟수가 1 보다 크면 워커가 잡다가 멈춰서 서버가 큐로 되돌린 것입니다.
        상한을 넘기면 실패로 확정되고 이유가 함께 남습니다.
    </p>
    <table class="table">
        <thead>
            <tr>
                <th class="table-fill">앱</th>
                <th class="table-tight">버전</th>
                <th class="table-tight">상태</th>
                <th class="table-tight">시도</th>
                <th class="table-tight">마지막 소식</th>
            </tr>
        </thead>
        <tbody>
            #for(job in jobs):
            <tr>
                <td class="table-fill table-strong">#(job.app)</td>
                <td class="table-tight table-muted">#(job.version)</td>
                <td class="table-tight">#(job.state)</td>
                <td class="table-tight">#(job.attempt)</td>
                <td class="table-tight table-muted">#if(job.lastSeen):#(job.lastSeen)#else:—#endif</td>
            </tr>
            #if(job.failureTitle):
            <tr>
                <td class="table-muted" colspan="5">
                    <strong>#(job.failureTitle)</strong>
                    <code class="failure-code">#(job.failureCode)</code>
                    <span class="table-note">#(job.failureAdvice)</span>
                    #if(job.note):
                    <span class="table-note">#(job.note)</span>
                    #endif
                    #if(job.log):
                    <details class="log">
                        <summary>서명 로그</summary>
                        <pre class="log-body">#(job.log)</pre>
                    </details>
                    #endif
                </td>
            </tr>
            #elseif(job.note):
            <tr>
                <td class="table-muted" colspan="5">
                    #(job.note)
                    #if(job.log):
                    <details class="log">
                        <summary>서명 로그</summary>
                        <pre class="log-body">#(job.log)</pre>
                    </details>
                    #endif
                </td>
            </tr>
            #endif
            #endfor
        </tbody>
    </table>
</section>
#endif

<!-- 워커 자기 갱신 (ADR-0042).
     워커가 자기 다음 버전을 서명하므로, 무엇을 배포할지는 사람이 정한다. -->
<section class="section">
    <h2 class="section-title">워커 릴리스</h2>
    <p class="body-text">
        워커는 여기 <strong>배포 중</strong>으로 표시된 번들과 자기 버전을 견줘, 낮으면
        일이 없을 때 스스로 갈아끼웁니다. 이 서버가 아는 버전은
        <code>#(serverWorkerVersion)</code> 입니다.
    </p>

    #if(count(releases) == 0):
    <p class="empty">아직 올린 릴리스가 없습니다. 워커는 계속 지금 깔린 채로 돕니다.</p>
    #else:
    <table class="table">
        <thead>
            <tr>
                <th class="table-fill">버전</th>
                <th class="table-tight">크기</th>
                <th class="table-tight">올린 때</th>
                <th class="table-tight">상태</th>
                <th class="table-tight"><span class="visually-hidden">동작</span></th>
            </tr>
        </thead>
        <tbody>
            #for(release in releases):
            <tr>
                <td class="table-fill table-strong">#(release.version)</td>
                <td class="table-tight table-muted">#(release.size)</td>
                <td class="table-tight table-muted">#(release.uploadedAt)</td>
                <td class="table-tight">
                    #if(release.isCurrent):
                    <span class="badge badge-released">배포 중</span>
                    #else:
                    <span class="badge">보관</span>
                    #endif
                </td>
                <td class="table-tight">
                    #if(release.isCurrent):
                    <span class="table-muted">—</span>
                    #else:
                    <form class="row-form" method="post"
                          action="/admin/workers/releases/#(release.id)/deploy">
                        <button class="button" type="submit">배포</button>
                    </form>
                    #endif
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif

    <form class="form" method="post" action="/admin/workers/releases"
          enctype="multipart/form-data">
        <label class="field">
            <span class="field-label">버전</span>
            <input class="input" type="text" name="version" required placeholder="0.2.0"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="field-note">
                워커 코드의 <code>WorkerVersion.current</code> 와 같아야 합니다. 점으로 나눈
                숫자만 받습니다.
            </span>
        </label>

        <label class="field">
            <span class="field-label">워커 번들 zip</span>
            <input class="input" type="file" name="bundle" required accept=".zip,application/zip">
            <span class="field-note">
                <code>./scripts/build-worker-app.sh --sign</code> 이 만든 zip 입니다.
                <strong>서명·공증된 것을 올리세요.</strong> 워커가 받아서 서명을 확인하고,
                우리 팀 것이 아니면 갈아끼우지 않습니다.
            </span>
        </label>

        <label class="check">
            <input type="checkbox" name="makeCurrent" value="on" checked>
            <span>올리자마자 배포</span>
        </label>

        <div class="form-actions">
            <button class="button button-primary" type="submit">릴리스 올리기</button>
        </div>
    </form>
</section>

<section class="section">
    <h2 class="section-title">워커 등록</h2>
    <form class="form" method="post" action="/admin/workers">
        <label class="field">
            <span class="field-label">이름</span>
            <input class="input" type="text" name="name" required placeholder="build-mac-01"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="field-note">어느 머신인지 알아볼 수 있는 이름이면 됩니다. 워커가 접속하면 자기 설정의 이름으로 덮어씁니다.</span>
        </label>
        <div class="form-actions">
            <button class="button button-primary" type="submit">토큰 발급</button>
        </div>
    </form>
</section>
#endexport
#endextend
